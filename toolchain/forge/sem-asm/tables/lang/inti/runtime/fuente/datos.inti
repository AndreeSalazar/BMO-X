# El byte Latin-1 de cada glifo extra, en el orden de arriba desde FUENTE_ASCII.
LATIN1 = [
    0xA1, 0xBF, 0xAA, 0xBA, 0xB0, 0xB7, 0xAC, 0xF1, 0xD1, 0xE1, 0xE9, 0xED, 0xF3, 0xFA, 0xFC, 0xC1, 0xC9, 0xCD, 0xD3, 0xDA, 0xDC, 0xE7, 0xC7, 0xB4, 0xA8
]

# La fila `f` (0..15) del glifo `g`: un byte, bit 7 = columna izquierda.
# Un glifo que no existe pinta el HUECO, y una fila de mas se recorta:
# el unico `crudo` de esta pieza solo lee DENTRO de la tabla.
funcion glifo_fila(g es natural64, f es natural64) devuelve natural64
    cambiante cual es natural64 = FUENTE_HUECO
    si g < FUENTE_GLIFOS
        cual = g
    crudo
        devuelve lee_natural8(GLIFOS + cual * 16 + (f bits_y 15))

# El indice de glifo de un byte Latin-1: el ASCII directo, un extra por su
# byte, o el HUECO si la fuente no lo tiene.
funcion glifo_de(byte es natural64) devuelve natural64
    si byte > 31 y byte < 127
        devuelve byte - 32
    cambiante i es natural64 = 0
    repite mientras i < FUENTE_EXTRAS
        si latin1_extra(i) = byte
            devuelve FUENTE_ASCII + i
        i = i + 1
    devuelve FUENTE_HUECO

funcion latin1_extra(i es natural64) devuelve natural64
    crudo
        devuelve lee_natural64(LATIN1 + i * 8)
