CREATE PROCEDURE dbo.AzMan_SP_GetRoleMemberCount 
(
@SqlRoleName nvarchar(64),
@count int output
)
AS
    select @count = count(*)  
    from sysusers u, sysusers g, sysmembers m  
    where   g.uid = m.groupuid
        and    g.name = @SqlRoleName
        and    g.issqlrole = 1  
        and    u.uid = m.memberuid
	RETURN
GO


