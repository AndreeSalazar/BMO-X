        --[ChildUpdateTimeStamp] 
        From [AzMan_AzApplication]
        where StoreID = @StoreID  

        SELECT @Error = @@ERROR, @RowCount = @@ROWCOUNT  
        if @Error <> 0 
        Begin
            Set @Return = @Error
        End
        else
        Begin
            Set @Return = 0
        End
        
    End
    Else if @Return = 3 -- Delegated user
    Begin

        -- Get all the child app where the current user has access
        Select
            [ID], 
            [ObjectGuid] ,
            [ApplyStoreSacl],
            [GenerateAudits], 
            [AuthzInterfaceClsId], 
            [ApplicationVersion],
            [Name],            
            [Description],
            [ApplicationData]
            --[ChildUpdateTimeStamp] 
