var g_albumArtFadingIn = false;
var g_albumArtFadingOut = false;


function InitPreviewOCXSkin()
{
    UpdateMainPanel();

    try {
        view.backgroundColor=Launcher.GetPreviewPaneColor();
    }
    catch(err) {}
}

function UpdateMainPanel()
{
    if (osMediaOpen == player.OpenState)
    {
        if (IsStopped() || !IsVideo()) 
        {
            svAlbumArt.visible=true;
            btnAlbumArtImgVisible.visible=true;
            svVideo.visible=false;
            UpdateAlbumDims();
        }
        else
        {
            svVideo.visible=true;
            btnAlbumArtImgVisible.visible=false;
            svAlbumArt.visible=false;
        } 
    }
    else
    { 
        svAlbumArt.visible=true;
        btnAlbumArtImgVisible.visible=true;
        svVideo.visible=false;
        UpdateAlbumDims();
    }
}


function IsStopped() {
    return (psStopped == player.playState || psReady == player.playState ||
             psMediaEnded == player.playState || psUndefined == player.playState);
}

function BoundsOnChange() {
    UpdateAlbumDims();
}

/* HACK ALERT 
 ********************************
 * We load our image into a hidden button first to get the correct height and width.
 * Then we use this height width to draw the actual thumbnail w/ the correct aspect
 * ratio.  I originally loaded the image into one file, got the height/width from 
 * that and then resized the image.  This worked fine in XP, but in longhorn, the 
 * height and width were always 0 even though the image was there... so this hack
 * gets around it. 
 */


var g_borderSize = 8;

function UpdateAlbumDims()
{   
    if (btnAlbumArtImgHidden.width == 0 || btnAlbumArtImgHidden.height == 0)
    {
        return;
    }
    // called right after we set the image (b4 resizing)

    var width = btnAlbumArtImgHidden.width;
    var height = btnAlbumArtImgHidden.height;
    
    var viewWidth = view.width-g_borderSize*2;
    var viewHeight = view.height-g_borderSize*2-50;
    
    var aspectRatio = height/width; 
 
    if ( (viewWidth*aspectRatio) > viewHeight)
    {
        // then we must scale to fit vertically
        viewWidth = viewHeight * width/height;
    }
    else 
    {   
        viewHeight = viewWidth * aspectRatio;
    }

    btnAlbumArtImgVisible.height = viewHeight;
    btnAlbumArtImgVisible.width = viewWidth;
}

function UpdateAlbumArt() 
{
    try {
        btnAlbumArtImgHidden.image =  Launcher.CreateThumbnail();
    }
    catch(err){}
}

function RemoveAlbumArt() 
{
    btnAlbumArtImgHidden.image = "";
}

function OnPlayStateUpdatePanel()
{
    UpdateMainPanel();
    if (IsStopped() && IsVideo())
    {  
        g_albumArtFadingIn = true;
        btnAlbumArtImgVisible.alphaBlend = 0;
        btnAlbumArtImgVisible.alphaBlendTo(255, 330);

        seek.thumbImage = "res://wmploc/RT_IMAGE/#455";     // when we stop, reset the thumb image to invisible
    }
    else if (psPlaying == player.playState)
    {
        seek.thumbImage = "res://wmploc/RT_IMAGE/#456";
    }
}

function DelayedPlay()
{
    // fade out the thumbnail and fade in the whatever it is.
    if (IsVideoBeforeOpen())
    {
        if (IsStopped())
        {
            // fade out and in only if stopped
            g_albumArtFadingOut = true; // get ready to rock
            btnAlbumArtImgVisible.alphaBlend = 255;
            btnAlbumArtImgVisible.alphaBlendTo(0, 330);
        }
        else {
            player.controls.Play();  // no fade, just play
        }
    }
    else {
        player.controls.Play();  // audio, just play
    }
}

function OnOpenStateUpdatePanel()
{
    var wmpos = player.openState;

    if (osPlaylistOpenNoMedia == wmpos)
    {
        UpdateAlbumArt();
    }
    if (osMediaChanging == wmpos)
    {
        RemoveAlbumArt();
        blackScreen.alphaBlend = 255;
    }
}

function IsVideoBeforeOpen()
{
    var fIsVideo = false;

    try {
        fIsVideo = Launcher.IsPerceivedTypeVideo();
    }
    catch (err) {}

    return fIsVideo;
}

function IsVideo() 
{
    return (player.currentMedia.ImageSourceWidth > 0 && player.currentMedia.imageSourceHeight > 0);
}

function HandleAlbumArtAlphaEnd()
{
    if (true==g_albumArtFadingOut)
    {
        g_albumArtFadingOut = false; 
        player.controls.Play();
        return;
    }

    if (true==g_albumArtFadingIn)
    {
        g_albumArtFadingIn = false; 
        return;
    }
}

function AdjustTransports()
{
    seek.width = view.width-2*seek.left;

    svTransportPlayGlow.left = svTransport.width/2 - 24;
}

function GoToFullPlayer()
{
    try {
        Launcher.LaunchFullPlayer();
    }
    catch (err) {}
}

function DetermineThumbImage(mouseOver)
{
    if ( mouseOver ) 
    {
        return "res://wmploc/RT_IMAGE/#448";
    }
    else
    {
        return seek.value == 0 ?  "res://wmploc/RT_IMAGE/#455" : "res://wmploc/RT_IMAGE/#456";
    }   
}