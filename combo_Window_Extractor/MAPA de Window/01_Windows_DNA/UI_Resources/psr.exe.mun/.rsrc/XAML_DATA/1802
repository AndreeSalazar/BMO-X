<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BannerBackgroundFillColorBrush"
                                     Color="#FFF4CE" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BannerBackgroundFillColorBrush"
                                     Color="#433519" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Grid.Resources>
    <Border Name="BannerBorder"
            Background="{ThemeResource BannerBackgroundFillColorBrush}"
            Grid.Column="0"
            Grid.Row="0"
            MinHeight="22"
            Padding="3,0,3,0"
            Visibility="Collapsed">
        <TextBlock FontSize="11"
                   Padding="0,10,0,10"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center">
            <Run Text="%s" />
            <Hyperlink Name="PsrDeprecationLink"
                       AutomationProperties.Name="%s"
                       NavigateUri="https://aka.ms/psrdep"
                       Foreground="#0039AA">%s</Hyperlink>
            <Run Text="%s" />
        </TextBlock>
    </Border>
    <StackPanel Grid.Column="0"
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                TabFocusNavigation="Local">
        <StackPanel.Resources>
            <Style x:Key="ToolbarButtonStyle"
                   TargetType="ContentControl">
                <Setter Property="VerticalAlignment"
                        Value="Top" />
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="FocusVisualMargin"
                        Value="0" />
                <Setter Property="Height"
                        Value="30" />
            </Style>
            <Style x:Key="ToolbarButtonStackPanelStyle"
                   TargetType="StackPanel">
                <Setter Property="Orientation"
                        Value="Horizontal" />
            </Style>
            <Style x:Key="ToolbarButtonGlyphStyle"
                   TargetType="TextBlock">
                <Setter Property="Grid.Row"
                        Value="0" />
                <Setter Property="Grid.Column"
                        Value="0" />
                <Setter Property="FontFamily"
                        Value="Segoe MDL2 Assets" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>
            <Style x:Key="ToolbarButtonTextStyle"
                   TargetType="TextBlock">
                <Setter Property="Grid.Row"
                        Value="0" />
                <Setter Property="Grid.Column"
                        Value="1" />
                <Setter Property="Margin"
                        Value="10,0,0,0" />
                <Setter Property="FontSize"
                        Value="12" />
                <Setter Property="FontFamily"
                        Value="Segoe UI" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>
        </StackPanel.Resources>
        <Button AutomationProperties.Name="%s"
                AutomationProperties.AccessKey="%s"
                Name="StartRecordButton"
                Width="133"
                Style="{StaticResource ToolbarButtonStyle}">
            <StackPanel Style="{StaticResource ToolbarButtonStackPanelStyle}">
                <TextBlock Text="&#xE7C8;"
                           Style="{StaticResource ToolbarButtonGlyphStyle}" />
                <TextBlock Text="%s"
                           Style="{StaticResource ToolbarButtonTextStyle}" />
            </StackPanel>
        </Button>
        <Button AutomationProperties.Name="%s"
                AutomationProperties.AccessKey="%s"
                Name="NewRecordingButton"
                Visibility="Collapsed"
                Width="133"
                Style="{StaticResource ToolbarButtonStyle}">
            <StackPanel Style="{StaticResource ToolbarButtonStackPanelStyle}">
                <TextBlock Text="&#xE7C8;"
                           Style="{StaticResource ToolbarButtonGlyphStyle}" />
                <TextBlock Text="%s"
                           Style="{StaticResource ToolbarButtonTextStyle}" />
            </StackPanel>
        </Button>
        <Button AutomationProperties.Name="%s"
                AutomationProperties.AccessKey="%s"
                Name="PauseRecordButton"
                Visibility="Collapsed"
                Width="133"
                Style="{StaticResource ToolbarButtonStyle}">
            <StackPanel Style="{StaticResource ToolbarButtonStackPanelStyle}">
                <TextBlock Text="&#xE769;"
                           Style="{StaticResource ToolbarButtonGlyphStyle}" />
                <TextBlock Text="%s"
                           Style="{StaticResource ToolbarButtonTextStyle}" />
            </StackPanel>
        </Button>
        <Button AutomationProperties.Name="%s"
                AutomationProperties.AccessKey="%s"
                Name="ResumeRecordButton"
                Visibility="Collapsed"
                Width="133"
                Style="{StaticResource ToolbarButtonStyle}">
            <StackPanel Style="{StaticResource ToolbarButtonStackPanelStyle}">
                <TextBlock Text="&#xE768;"
                           Style="{StaticResource ToolbarButtonGlyphStyle}" />
                <TextBlock Text="%s"
                           Style="{StaticResource ToolbarButtonTextStyle}" />
            </StackPanel>
        </Button>
        <Button AutomationProperties.Name="%s"
                AutomationProperties.AccessKey="%s"
                Name="StopRecordButton"
                IsEnabled="false"
                Width="133"
                Style="{StaticResource ToolbarButtonStyle}">
            <StackPanel Style="{StaticResource ToolbarButtonStackPanelStyle}">
                <TextBlock Text="&#xF16E;"
                           Style="{StaticResource ToolbarButtonGlyphStyle}" />
                <TextBlock Text="%s"
                           Style="{StaticResource ToolbarButtonTextStyle}" />
            </StackPanel>
        </Button>
        <Button AutomationProperties.Name="%s"
                AutomationProperties.AccessKey="%s"
                Name="SaveButton"
                Visibility="Collapsed"
                Width="133"
                Style="{StaticResource ToolbarButtonStyle}">
            <StackPanel Style="{StaticResource ToolbarButtonStackPanelStyle}">
                <TextBlock Text="&#xE74E;"
                           Style="{StaticResource ToolbarButtonGlyphStyle}" />
                <TextBlock Text="%s"
                           Style="{StaticResource ToolbarButtonTextStyle}" />
            </StackPanel>
        </Button>
        <Button AutomationProperties.Name="%s"
                AutomationProperties.AccessKey="%s"
                Name="SettingsButton"
                Width="133"
                Style="{StaticResource ToolbarButtonStyle}">
            <StackPanel Style="{StaticResource ToolbarButtonStackPanelStyle}">
                <TextBlock Text="&#xE713;"
                           Style="{StaticResource ToolbarButtonGlyphStyle}" />
                <TextBlock Text="%s"
                           Style="{StaticResource ToolbarButtonTextStyle}" />
            </StackPanel>
        </Button>
    </StackPanel>
</Grid>