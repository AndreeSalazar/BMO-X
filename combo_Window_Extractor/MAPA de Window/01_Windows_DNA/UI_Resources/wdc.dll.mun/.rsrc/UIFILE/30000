<if class="standby">
<element tooltip="true" background="themeable(gradient(RGB(85,142,213),RGB(49,116,197),1),RGB(49,116,197))" accessible="true" accname="resstr(33868)" accdesc="resstr(33604)" accrole="graphic"/>
</if>
<if class="modified">
<element tooltip="true" background="themeable(gradient(RGB(255,153,0),RGB(204,121,0),1),RGB(204,121,0))" accessible="true" accname="resstr(33857)" accdesc="resstr(33605)" accrole="graphic"/>
</if>
