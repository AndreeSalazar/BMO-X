<if class="rheader">
<element layoutpos="right" contentalign="topright|endellipsis" margin="rect(0rp,0rp,0rp,0rp)" padding="rect(0rp,0rp,2rp,0rp)" accessible="true" accname="resstr(34220)" accrole="statictext" accstate="0x00000040"/>
