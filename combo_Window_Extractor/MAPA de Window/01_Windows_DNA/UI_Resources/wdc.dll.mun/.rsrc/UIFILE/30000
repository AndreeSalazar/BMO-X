<element layoutpos="top" background="argb(0,0,0,0)" font="MessageFont" margin="rect(10rp,0rp,10rp,0rp)" padding="rect(10rp,0rp,0rp,0rp)" borderthickness="rect(0rp,0rp,0rp,0rp)" contentalign="topleft"/>
