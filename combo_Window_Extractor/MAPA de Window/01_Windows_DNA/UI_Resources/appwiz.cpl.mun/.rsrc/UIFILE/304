<duixml>
<stylesheets>
<style resid="frame">
<ocmframe
accessible = "true"
accRole = "16"
accName = "resstr(186)"
font = "IconFont"
background = "threedface"
foreground = "windowtext"
/>
</style>
<style resid="contentpane">
<if id="atom(introheader)">
<element
font = "gtf(CONTROLPANELSTYLE,5,0)"
foreground = "gtc(CONTROLPANELSTYLE,5,0,3803)"
padding = "rect(0rp,0rp,0rp,10rp)"
/>
</if>
<if id="atom(contentpane)">
<element
padding = "rect(10rp,10rp,10rp,10rp)"
/>
</if>
<if id="atom(installedlistcontainer)">
<element
borderthickness = "rect(1rp,1rp,1rp,1rp)"
bordercolor = "buttonshadow"
padding = "rect(0,0,0,0)"
/>
</if>
<if id="atom(publishedlistcontainer)">
<element
borderthickness = "rect(1rp,1rp,1rp,1rp)"
bordercolor = "buttonshadow"
padding = "rect(0,0,0,0)"
/>
</if>
<if id="atom(ocsetuplistcontainer)">
<element
borderthickness = "rect(1rp,1rp,1rp,1rp)"
bordercolor = "buttonshadow"
padding = "rect(0,0,0,0)"
/>
</if>
<if id="atom(label)">
<element
padding = "rect(0,4rp,5rp,2rp)"
/>
</if>
<if id="atom(sort)">
<element
padding = "rect(2rp,4rp,2rp,2rp)"
/>
</if>
<if id="atom(changecontentheader)">
<element
padding = "rect(0,0,0,4rp)"
/>
</if>
<if pressed="true">
<button
background = "themeable(dtb(Button, 1, 3), dfc(4, 0x0010 | 0x0200))"
padding = "rect(9rp,7rp,7rp,5rp)"
/>
</if>
<if keyfocused="true">
<button
contentalign = "focusrect"
/>
</if>
</style>
<style resid="treeview">
<element
borderstyle = "solid"
borderthickness = "rect(1rp,1rp,1rp,1rp)"
bordercolor = "buttonshadow"
margin = "rect(0,10rp,0,0)"
padding = "rect(10rp,20rp,10rp,10rp)"
/>
<OCMTreeView 
borderstyle = "solid"
borderthickness = "rect(1rp,1rp,1rp,1rp)"
bordercolor = "buttonshadow"
margin = "rect(0,10rp,0,0)"
/>
</style> 
<style resid="closepane">
<if id="atom(closepane)">
<element
background = "buttonface"
padding = "rect(10rp,10rp,10rp,10rp)"
/>
</if>
<button
background = "themeable(dtb(Button, 1, 1), dfc(4, 0x0010))"
foreground = "buttontext"
padding = "rect(8rp,6rp,8rp,6rp)"
margin = "rect(5rp,5rp,5rp,5rp)"
/>
<if mousefocused="true">
<button
background = "dtb(Button, 1, 2)"
/>
</if>
<ccpushbutton
transparent="true"
minsize="size(75rp,25rp)"
accessible="true"
/>
<if selected="true">
<button background="dtb(Button, 1, 5)" />
</if>
</style>
</stylesheets>
</duixml>
