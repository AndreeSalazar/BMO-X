<duixml>
<stylesheets>
<style
resid   = 'FlyoutStyleSheet'
>
<element 
background      = 'argb(0,0,0,0)'
/>
<if 
class   = "FlyoutElement"
>
<element 
foreground      = 'themeable(gtc(Flyout, 2, 0, 3803),windowtext)'
background      = 'themeable(dtb(Flyout, 6, 0),window)'
font            = 'gtf(FLYOUTSTYLE, 2, 0)'
padding         = 'rect(0rp,0rp,0rp,0rp)'
/>
</if>
</style>
<style 
resid   = 'TextLinkSS'
>
<button 
foreground      = 'themeable(gtc(Flyout, 4, 1, 3803),HotLight)'
font            = "gtf(FlyoutStyle, 4, 1)"
AccRole         = 'link' 
Accessible      = 'true'
cursor          = 'hand'
ContentAlign    = 'WrapLeft' 
/>
<if 
keyfocused      = 'true'
>
<button 
contentalign    = 'middlecenter | focusrect'
font            = 'gtf(FlyoutStyle, 4, 2)'
foreground      = 'themeable(gtc(Flyout, 4, 2, 3803),HotLight)'
cursor          = 'hand'
/>
</if>
<if 
mousefocused    = 'true'
>
<button 
font            = "gtf(FlyoutStyle, 4, 2)"
foreground      = 'themeable(gtc(Flyout, 4, 2, 3803),HotLight)'
cursor          = 'hand'
/>
</if>
</style>
<style 
resid   = 'BattEntrySS'
>
<if 
keyfocused      = 'true'
>
<element 
contentalign    = 'focusrect' 
/>
</if>
</style>
<style 
resid   = 'scrollParts'
>
<if 
class   = 'ScrollViewer' 
>
<CCHScrollBar 
layoutpos       = 'ninebottom' 
accessible      = 'true'
/>
<CCVScrollBar 
layoutpos       = 'nineright'
accessible      = 'true'
/>
<viewer
layoutpos       = 'nineclient'
/>
</if>
</style>
</stylesheets>
<PowerFlyout 
resid       = 'main' 
Layout      = 'BorderLayout()' 
Sheet       = 'FlyoutStyleSheet'
>
<element 
id          = 'atom(mainwindow)'
LayoutPos   = 'top'
Layout      = 'BorderLayout()' 
class       = 'ToolTipElement'
>
<element 
id          = 'atom(CompositeBattery)'
LayoutPos   = 'top' 
Layout      = 'BorderLayout()' 
padding     = 'rect(16rp, 5rp, 16rp, 0rp)' 
/>
<element 
Layout      = 'BorderLayout()' 
LayoutPos   = 'client' 
id          = 'atom(body)' 
/>
</element>
<element 
Layout      = 'BorderLayout()' 
LayoutPos   = 'bottom' 
id          = 'atom(links)' 
/>
</PowerFlyout>
<element 
resid       = 'flyout'
LayoutPos   = 'top' 
Layout      = 'BorderLayout()'
>
<scrollviewer 
id              = 'atom(battviewer)' 
LayoutPos       = 'top' 
xscrollable     = 'false' 
yscrollable     = 'true' 
xbarvisibility  = 'never' 
ybarvisibility  = 'asneeded' 
sheet           = 'ScrollParts'
>
<selector 
id              = 'atom(battgroup)' 
AccName         = "resstr(197)"
Accessible      = 'true'
layoutpos       = 'nineclient' 
Layout          = 'BorderLayout()'
padding         = 'rect(5rp, 2rp, 5rp, 2rp)' 
Sheet           = 'FlyoutStyleSheet'
>
</selector>
</scrollviewer>
<element 
Layoutpos       = 'top' 
Layout          = 'FillLayout()' 
Padding         = 'rect(0rp, 4rp, 0rp, 2rp)'
>
<element 
id              = 'atom(divider)'
Accessible      = 'true'
AccRole         = 'graphic'
Height          = '1rp'
background      = 'themeable(dtb(Flyout, 5, 0), gradient(threedhighlight,threedface,threedshadow,4))'
/>
</element>
<element 
id              = 'atom(selectplan)' 
Layoutpos       = 'top' 
AccRole         = 'statictext' 
Accessible      = 'true' 
AccName         = "resstr(192)"
content         = "resstr(192)"
contentalign    = 'WrapLeft'
font            = 'gtf(FLYOUTSTYLE, 2, 0)'
foreground      = 'themeable(gtc(Flyout, 2, 0, 3803), windowtext)'
Padding         = 'rect(16rp,3rp,16rp,3rp)'
/>
<button 
id              = 'atom(helplua)' 
layoutpos       = 'top' 
AccRole         = 'statictext'
AccName         = "resstr(196)"
content         = "resstr(196)"
Padding         = 'rect(10rp,3rp,5rp,3rp)'
sheet           = 'TextLinkSS' 
/>
<element 
layoutpos       = 'top' 
padding         = 'rect(5rp, 1rp, 5rp, 5rp)' 
layout          = 'BorderLayout()' 
>
<SelectorNoDefault 
id              = 'atom(radiogroup)' 
Accessible      = 'true'
AccName         = "resstr(194)"
layoutpos       = 'top' 
layout          = 'BorderLayout()'
padding         = 'rect(16rp,0rp,16rp,5rp)' 
font            = 'gtf(FLYOUTSTYLE, 2, 0)'
foreground      = 'themeable(gtc(Flyout, 2, 0, 3803), windowtext)'
background      = 'themeable(argb(0,0,0,0),window)'
>
</SelectorNoDefault>
</element>
<element 
id          = 'atom(warningmsg)' 
Layout      = 'BorderLayout()' 
layoutpos   = 'top' 
>
<element 
id              = 'atom(warningicon)' 
content         = 'icon(104, sysmetric(49), sysmetric(50), library(user32.dll))'
layoutpos       = 'left'
AccRole         = 'graphic' 
Accessible      = 'true' 
padding         = 'rect(16rp,5rp,0rp,5rp)'
/>
<element 
id              = 'atom(warningtext)'
layoutpos       = 'client'
AccRole         = 'statictext' 
Accessible      = 'true' 
contentalign    = 'wrapleft'
padding         = 'rect(8rp,5rp,10rp,5rp)'
font            = 'gtf(FLYOUTSTYLE, 2, 0)'
foreground      = 'themeable(gtc(Flyout, 2, 0, 3803),windowtext)' 
/>
</element>
<element
id          = 'atom(healthmsg)'
Layout      = 'BorderLayout()'
layoutpos   = 'top'
>
<CCCheckbox
id           = 'atom(healthcheckbox)'
layoutpos    = 'client'
AccRole      = 'checkbutton'
AccName      = "resstr(128)"
Accessible   = 'true'
Selected     = 'true'
active       = 'mouse|keyboard'
padding      = 'rect(16rp,5rp,16rp,5rp)'
Enabled      = 'true'
content      = "resstr(128)"
contentAlign = 'wrapleft'
/>
</element>
</element>
<element 
resid           = 'linkarea' 
Layoutpos       = 'top' 
Layout          = 'BorderLayout()' 
background      = 'themeable(dtb(Flyout, 7, 0), ButtonFace)'
>
<element
Layoutpos       = 'top' 
Layout          = 'VerticalFlowLayout(0,2)' 
Padding         = 'rect(0rp, 12rp, 0rp, 13rp)'
>
<button 
id          = 'atom(launchcpl)' 
AccName     = "resstr(193)"
content     = "resstr(193)"
sheet       = 'TextLinkSS' 
Padding         = 'rect(0rp, 2rp, 0rp, 1rp)'
/>
</element>
</element>
<CCRadioButton 
resid       = 'RadioEntry' 
LayoutPos   = 'top'
Accessible  = 'true' 
AccRole     = 'radiobutton' 
ToolTip     = 'true'
active      = 'mouse|keyboard' 
padding     = 'rect(0rp,2rp,0rp,3rp)' 
transparent = 'true'
/>
<element 
resid       = 'MainBatteryElement'
Layout      = 'BorderLayout()' 
>
<element 
id              = 'atom(BatteryWarning)'
padding         = 'rect(5rp,5rp,3rp,3rp)'
sheet           = 'TextLinkSS'
Accessible      = 'true'
AccRole         = 'statictext' 
/>
<element 
id              = 'atom(BatteryIcon)'
LayoutPos       = 'left' 
AccRole         = 'graphic' 
Accessible      = 'true' 
AccName         = "resstr(190)"
padding         = 'rect(5rp,5rp,5rp,5rp)'
/>
<element 
id              = 'atom(BatteryDescription)' 
LayoutPos       = 'client' 
Accessible      = 'true' 
AccRole         = 'statictext' 
contentalign    = 'WrapLeft'
font            = 'gtf(FLYOUTSTYLE, 1, 0)'
foreground      = 'themeable(gtc(Flyout, 1, 0, 3803), windowtext)'
padding         = 'rect(1rp, 5rp, 5rp, 5rp)'
/>
</element>
<element 
resid       = 'BatteryElement'
sheet       = 'BattEntrySS' 
Layout      = 'BorderLayout()'
active      = 'mouse|keyboard'
>
<button 
id              = 'atom(BatteryWarning)'
padding         = 'rect(5rp,5rp,5rp,5rp)'
active          = 'inactive'
sheet           = 'TextLinkSS'
Accessible      = 'true'
AccRole         = 'statictext' 
LayoutPos       = 'bottom' 
/>
<button 
id              = 'atom(BatteryIcon)'
active          = 'inactive'
LayoutPos       = 'left' 
AccRole         = 'graphic' 
Accessible      = 'true' 
AccName         = "resstr(190)"
padding         = 'rect(5rp,5rp,5rp,5rp)'
/>
<element 
id              = 'atom(BatteryDescription)' 
active          = 'inactive'
LayoutPos       = 'client' 
Accessible      = 'true' 
AccRole         = 'statictext' 
contentalign    = 'WrapLeft | endellipsis'
font            = 'gtf(FLYOUTSTYLE, 3, 1)'
foreground      = 'themeable(gtc(FLYOUTSTYLE, 3, 1, 3803),windowtext)' 
padding         = 'rect(5rp, 5rp, 5rp, 5rp)'
/>
</element>
<element 
content     = 'icon(101, sysmetric(49), sysmetric(50), library(user32.dll))'
resid       = 'WarningIconOverlay'
LayoutPos   = 'absolute'
Padding     = 'rect(5rp,5rp,5rp,5rp)'
background  = 'window' 
>
</element>
</duixml>
