     1                                  ; ============================================================================
     2                                  ; FastOS Stage 1 — MBR Boot Sector (512 bytes)
     3                                  ; ============================================================================
     4                                  ; Real mode 16-bit. Loaded by BIOS at 0x7C00.
     5                                  ; Job: set up segments, load stage2 from disk, verify it, jump to it.
     6                                  ; ============================================================================
     7                                  
     8                                  [BITS 16]
     9                                  [ORG 0x7C00]
    10                                  
    11                                  stage1_start:
    12 00000000 FA                          cli
    13 00000001 31C0                        xor ax, ax
    14 00000003 8ED8                        mov ds, ax
    15 00000005 8EC0                        mov es, ax
    16 00000007 8ED0                        mov ss, ax
    17 00000009 BC007C                      mov sp, 0x7C00
    18 0000000C FB                          sti
    19                                  
    20                                      ; Save boot drive (BIOS passes in DL)
    21 0000000D 8816[A500]                  mov [boot_drive], dl
    22                                  
    23 00000011 BE[A600]                    mov si, msg_boot
    24 00000014 E87D00                      call print_string_16
    25                                  
    26                                      ; ── Test LBA extensions (AH=41h) ─────────────────────────────────────
    27 00000017 B441                        mov ah, 0x41
    28 00000019 BBAA55                      mov bx, 0x55AA
    29 0000001C 8A16[A500]                  mov dl, [boot_drive]
    30 00000020 CD13                        int 0x13
    31 00000022 7221                        jc .use_chs             ; CF=1 → no LBA → use CHS
    32 00000024 81FB55AA                    cmp bx, 0xAA55
    33 00000028 751B                        jne .use_chs            ; bad signature → use CHS
    34                                  
    35                                      ; ── LBA path: load Stage2 via AH=42h ─────────────────────────────────
    36 0000002A BE[C400]                    mov si, msg_lba
    37 0000002D E86400                      call print_string_16
    38 00000030 BE[EC00]                    mov si, msg_loading
    39 00000033 E85E00                      call print_string_16
    40                                  
    41 00000036 B442                        mov ah, 0x42
    42 00000038 8A16[A500]                  mov dl, [boot_drive]
    43 0000003C BE[6401]                    mov si, dap
    44 0000003F CD13                        int 0x13
    45 00000041 7249                        jc disk_error
    46 00000043 EB29                        jmp .verify
    47                                  
    48                                  .use_chs:
    49                                      ; ── CHS path: load Stage2 via AH=02h ─────────────────────────────────
    50 00000045 BE[D800]                    mov si, msg_chs
    51 00000048 E84900                      call print_string_16
    52 0000004B BE[EC00]                    mov si, msg_loading
    53 0000004E E84300                      call print_string_16
    54                                  
    55                                      ; Reset disk controller first
    56 00000051 31C0                        xor ax, ax
    57 00000053 8A16[A500]                  mov dl, [boot_drive]
    58 00000057 CD13                        int 0x13
    59                                  
    60                                      ; Read 32 sectors: CHS(0,0,2) = LBA 1, destination 0x0000:0x7E00
    61 00000059 B402                        mov ah, 0x02
    62 0000005B B020                        mov al, 32             ; 32 sectors = 16KB = Stage2
    63 0000005D B500                        mov ch, 0              ; Cylinder 0
    64 0000005F B102                        mov cl, 2              ; Sector 2 (CHS is 1-based, LBA 1 = sector 2)
    65 00000061 B600                        mov dh, 0              ; Head 0
    66 00000063 8A16[A500]                  mov dl, [boot_drive]
    67 00000067 BB007E                      mov bx, 0x7E00         ; ES:BX = 0x0000:0x7E00
    68 0000006A CD13                        int 0x13
    69 0000006C 721E                        jc disk_error
    70                                  
    71                                  .verify:
    72                                      ; ── Verify Stage2 loaded correctly ───────────────────────────────────
    73 0000006E 803E007EE9                  cmp byte [0x7E00], 0xE9
    74 00000073 7408                        je .stage2_ok
    75                                  
    76 00000075 BE[4401]                    mov si, msg_bad_data
    77 00000078 E81900                      call print_string_16
    78 0000007B FA                          cli
    79 0000007C F4                          hlt
    80                                  
    81                                  .stage2_ok:
    82 0000007D BE[0901]                    mov si, msg_jumping
    83 00000080 E81100                      call print_string_16
    84                                  
    85                                      ; Jump to stage2 (restore DL)
    86 00000083 8A16[A500]                  mov dl, [boot_drive]
    87 00000087 EA007E0000                  jmp 0x0000:0x7E00
    88                                  
    89                                  disk_error:
    90 0000008C BE[2801]                    mov si, msg_disk_err
    91 0000008F E80200                      call print_string_16
    92 00000092 FA                          cli
    93 00000093 F4                          hlt
    94                                  
    95                                  ; --- Print null-terminated string (SI) ---
    96                                  print_string_16:
    97 00000094 60                          pusha
    98                                  .loop:
    99 00000095 AC                          lodsb
   100 00000096 08C0                        or al, al
   101 00000098 7409                        jz .done
   102 0000009A B40E                        mov ah, 0x0E
   103 0000009C BB0700                      mov bx, 0x0007
   104 0000009F CD10                        int 0x10
   105 000000A1 EBF2                        jmp .loop
   106                                  .done:
   107 000000A3 61                          popa
   108 000000A4 C3                          ret
   109                                  
   110                                  ; --- Data ---
   111 000000A5 00                      boot_drive:   db 0
   112 000000A6 5B466173744F535D20-     msg_boot:     db "[FastOS] Stage1: MBR loaded", 13, 10, 0
   112 000000AF 5374616765313A204D-
   112 000000B8 4252206C6F61646564-
   112 000000C1 0D0A00             
   113 000000C4 5B466173744F535D20-     msg_lba:      db "[FastOS] LBA mode", 13, 10, 0
   113 000000CD 4C4241206D6F64650D-
   113 000000D6 0A00               
   114 000000D8 5B466173744F535D20-     msg_chs:      db "[FastOS] CHS mode", 13, 10, 0
   114 000000E1 434853206D6F64650D-
   114 000000EA 0A00               
   115 000000EC 5B466173744F535D20-     msg_loading:  db "[FastOS] Loading Stage2...", 13, 10, 0
   115 000000F5 4C6F6164696E672053-
   115 000000FE 74616765322E2E2E0D-
   115 00000107 0A00               
   116 00000109 5B466173744F535D20-     msg_jumping:  db "[FastOS] Stage2 verified OK!", 13, 10, 0
   116 00000112 537461676532207665-
   116 0000011B 726966696564204F4B-
   116 00000124 210D0A00           
   117 00000128 5B466173744F535D20-     msg_disk_err: db "[FastOS] DISK READ ERROR!", 13, 10, 0
   117 00000131 4449534B2052454144-
   117 0000013A 204552524F52210D0A-
   117 00000143 00                 
   118 00000144 5B466173744F535D20-     msg_bad_data: db "[FastOS] STAGE2 DATA INVALID!", 13, 10, 0
   118 0000014D 535441474532204441-
   118 00000156 544120494E56414C49-
   118 0000015F 44210D0A00         
   119                                  
   120                                  ; Disk Address Packet (INT 13h AH=42h)
   121                                  align 4
   122                                  dap:
   123 00000164 10                          db 0x10                 ; DAP size
   124 00000165 00                          db 0                    ; Reserved
   125 00000166 2000                        dw 32                   ; Sectors to read (32 × 512 = 16KB)
   126 00000168 007E                        dw 0x7E00               ; Offset
   127 0000016A 0000                        dw 0x0000               ; Segment
   128 0000016C 0100000000000000            dq 1                    ; Starting LBA (sector 1)
   129                                  
   130                                  ; MBR signature
   131 00000174 00<rep 8Ah>             times 510 - ($ - $$) db 0
   132 000001FE 55AA                    dw 0xAA55
