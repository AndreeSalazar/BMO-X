    46                                      ; ── CRITICAL: Save boot drive (DL) IMMEDIATELY ───────────────────────
    47                                      ; BIOS sets DL=0x80 (first hard drive) on boot. Save it NOW before
    48                                      ; any code execution to prevent corruption.
    49 000006B1 8816[6509]                  mov [stage2_boot_drive], dl
    50                                  
    51                                      ; ── Ultra-early VGA diagnostic ───────────────────────────────────────
    52                                      ; Write "S2" directly to VGA text buffer at bottom-left (row 24).
    53                                      ; This proves Stage2 code is executing, even if INT 10h or segments
    54                                      ; are broken. If you see "S2" on screen but no Stage2 messages,
    55                                      ; the crash is happening between here and the first print_string_16.
    56 000006B5 B800B8                      mov ax, 0xB800
    57 000006B8 8EC0                        mov es, ax
    58 000006BA 26C706000F534F              mov word [es:3840], 0x4F53      ; 'S' white-on-red, row 24, col 0
    59 000006C1 26C706020F324F              mov word [es:3842], 0x4F32      ; '2' white-on-red, row 24, col 1
