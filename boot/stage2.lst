   249                                      ; VGA print — continue from where BIOS left off (don't overwrite!)
   250                                      ; Read saved row from real mode, compute offset
   251 0000092C 0FB605[5B080000]            movzx eax, byte [vga_row]
   252 00000933 69C0A0000000                imul eax, 160                   ; 80 cols × 2 bytes per char
   253 00000939 0500800B00                  add eax, 0xB8000
   254 0000093E 89C7                        mov edi, eax
   255 00000940 BE[DC090000]                mov esi, msg_pm_ok
   256 00000945 B40A                        mov ah, 0x0A                    ; light green on black
   257                                  .pm_print:
   258 00000947 AC                          lodsb
   259 00000948 84C0                        test al, al
   260 0000094A 7404                        jz .pm_print_done
   261 0000094C 66AB                        stosw
   262 0000094E EBF7                        jmp .pm_print
   263                                  .pm_print_done:
   264                                  
   265                                      ; Detect CPU features for kernel
   266 00000950 E8E5F8FFFF                  call detect_cpu_features_32
   267                                  
   268                                      ; Copy kernel: 0x20000 → 0x100000 (1MB), 131KB
   269 00000955 BE00000200                  mov esi, 0x20000
   270 0000095A BF00001000                  mov edi, 0x100000
   271 0000095F B902800000                  mov ecx, 32770                  ; 131KB / 4 bytes = 32770 dwords
   272 00000964 F3A5                        rep movsd
   273                                  
   274                                      ; ── Phase 3: Paging + Long Mode ──────────────────────────────────────
   275                                  
   276                                      ; VGA progress — next row
   277 00000966 0FB605[5B080000]            movzx eax, byte [vga_row]
   278 0000096D 40                          inc eax
   279 0000096E 69C0A0000000                imul eax, 160
   280 00000974 0500800B00                  add eax, 0xB8000
   281 00000979 89C7                        mov edi, eax
   282 0000097B BE[F8090000]                mov esi, msg_paging_ok
   283 00000980 B40E                        mov ah, 0x0E                    ; yellow on black
   284                                  .pg_print:
   285 00000982 AC                          lodsb
   286 00000983 84C0                        test al, al
   287 00000985 7404                        jz .pg_print_done
   288 00000987 66AB                        stosw
   289 00000989 EBF7                        jmp .pg_print
   290                                  .pg_print_done:
   291                                  
   292 0000098B E8DCFEFFFF                  call setup_paging
   293                                  
   294                                      ; Load PML4 into CR3
   295 00000990 B800100000                  mov eax, PML4_ADDR
   296 00000995 0F22D8                      mov cr3, eax
   297                                  
   298                                      ; Enable PAE
   299 00000998 0F20E0                      mov eax, cr4
   300 0000099B 83C820                      or eax, (1 << 5)
   301 0000099E 0F22E0                      mov cr4, eax
   302                                  
   303                                      ; Enable Long Mode (EFER.LME) + NX (EFER.NXE)
   304 000009A1 B9800000C0                  mov ecx, 0xC0000080
   305 000009A6 0F32                        rdmsr
   306 000009A8 0D00010000                  or eax, (1 << 8)               ; LME
   307 000009AD 0D00080000                  or eax, (1 << 11)              ; NXE
   308 000009B2 0F30                        wrmsr
   309                                  
   310                                      ; Enable paging + write protect
   311 000009B4 0F20C0                      mov eax, cr0
   312 000009B7 0D00000080                  or eax, (1 << 31)              ; PG
   313 000009BC 0D00000100                  or eax, (1 << 16)              ; WP
   314 000009C1 0F22C0                      mov cr0, eax
   315                                  
   316                                      ; Patch GDT64 descriptor base address (already linear in PM, but be explicit)
   317 000009C4 C705[3B000000]-             mov dword [gdt64_descriptor + 2], gdt64_start
   317 000009CA [21000000]         
   318 000009CE 0F0115[39000000]            lgdt [gdt64_descriptor]
   319                                  
   320                                      ; Far jump to 64-bit!
   321 000009D5 EA[5C0A0000]0800            jmp GDT64_CODE_SEG:long_mode_entry
   322                                  
   323 000009DC 5B466173744F535D20-     msg_pm_ok:      db "[FastOS] Protected Mode: OK", 0
   323 000009E5 50726F746563746564-
   323 000009EE 204D6F64653A204F4B-
   323 000009F7 00                 
   324 000009F8 5B466173744F535D20-     msg_paging_ok:  db "[FastOS] Paging + Long Mode setup...", 0
   324 00000A01 506167696E67202B20-
   324 00000A0A 4C6F6E67204D6F6465-
   324 00000A13 2073657475702E2E2E-
   324 00000A1C 00                 
