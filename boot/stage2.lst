   394                                      ; ── Build boot info for Rust kernel ──────────────────────────────────
   395                                  
   396                                      ; Boot info at 0x9100 (passed in RDI to Rust)
   397 00000B0F 48C704250091000005-         mov qword [0x9100], 0xFA5705           ; magic
   397 00000B18 57FA00             
   398 00000B1B 48C704250891000000-         mov qword [0x9108], 0x8000             ; memory_map_addr
   398 00000B24 800000             
   399 00000B27 8B042500800000              mov eax, [0x8000]
   400 00000B2E 4889042510910000            mov qword [0x9110], rax                ; memory_map_count
   401 00000B36 48C704251891000000-         mov qword [0x9118], 0x9000             ; cpu_features_addr
   401 00000B3F 900000             
   402                                  
   403                                      ; Framebuffer: use VBE address if set, otherwise VGA 0xB8000
   404 00000B42 8B0425[41030000]            mov eax, [vbe_fb_addr]
   405 00000B49 4889042520910000            mov qword [0x9120], rax                ; framebuffer_addr
   406 00000B51 48C704252891000000-         mov qword [0x9128], 0x100000           ; kernel_start
   406 00000B5A 001000             
   407 00000B5D 48C704253091000000-         mov qword [0x9130], 132 * 1024         ; kernel_size (132KB)
   407 00000B66 100200             
   408                                  
   409                                      ; Extended boot info: VBE data
   410 00000B69 0FB70425[45030000]          movzx eax, word [vbe_pitch]
   411 00000B71 4889042538910000            mov qword [0x9138], rax                ; fb_pitch
   412 00000B79 0FB60425[47030000]          movzx eax, byte [vbe_mode_ok]
   413 00000B81 4889042540910000            mov qword [0x9140], rax                ; vbe_mode (1=graphics, 0=text)
   414                                  
   415                                      ; Extended boot info: GSP Firmware (loaded by payload_loader.asm)
   416 00000B89 8B0425[98040000]            mov eax, dword [payload_base]
   417 00000B90 4889042548910000            mov qword [0x9148], rax                ; gpu_fw_addr
   418 00000B98 8B0425[A0040000]            mov eax, dword [payload_size]
   419 00000B9F 4889042550910000            mov qword [0x9150], rax                ; gpu_fw_size
   420                                  
   421                                      ; ── Jump to Rust kernel with System V AMD64 ABI arguments ─────────────
   422                                      ; RDI = GSP firmware address (0x1000000)
   423                                      ; RSI = GSP firmware size (72845296)
   424                                      ; RDX = memory map pointer (0x8000)
   425                                  
   426 00000BA7 BF00000001                  mov rdi, 0x1000000              ; GSP firmware address
   427 00000BAC BEF0875704                  mov rsi, 72845296               ; GSP firmware size
   428 00000BB1 BA00800000                  mov rdx, 0x8000                 ; Memory map pointer
   429                                  
   430 00000BB6 B800001000                  mov rax, 0x100000              ; Kernel entry point
   431 00000BBB FFE0                        jmp rax
