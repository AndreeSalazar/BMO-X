   240                                  %include "paging.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS Paging — 4-level page tables for Long Mode (x86-64)
     3                              <1> ; ============================================================================
     4                              <1> ; Identity maps first 4GB using 2MB huge pages.
     5                              <1> ; Ryzen 5 5600X supports: 4-level, 1GB/2MB/4KB pages, NX, PCID
     6                              <1> ; ============================================================================
     7                              <1> 
     8                              <1> [BITS 32]
     9                              <1> 
    10                              <1> PAGE_PRESENT    equ 0x01
    11                              <1> PAGE_WRITABLE   equ 0x02
    12                              <1> PAGE_HUGE       equ 0x80
    13                              <1> PAGE_FLAGS      equ (PAGE_PRESENT | PAGE_WRITABLE)
    14                              <1> PAGE_HUGE_FLAGS equ (PAGE_PRESENT | PAGE_WRITABLE | PAGE_HUGE)
    15                              <1> 
    16                              <1> PML4_ADDR       equ 0x1000
    17                              <1> PDPT_ADDR       equ 0x2000
    18                              <1> PD0_ADDR        equ 0x3000
    19                              <1> PD1_ADDR        equ 0x4000
    20                              <1> PD2_ADDR        equ 0x5000
    21                              <1> PD3_ADDR        equ 0x6000
    22                              <1> 
    23                              <1> setup_paging:
    24                              <1>     ; Clear 6 pages of page tables (24KB)
    25 00000978 BF00100000          <1>     mov edi, PML4_ADDR
    26 0000097D 31C0                <1>     xor eax, eax
    27 0000097F B900180000          <1>     mov ecx, 6 * 1024
    28 00000984 F3AB                <1>     rep stosd
    29                              <1> 
    30                              <1>     ; PML4[0] → PDPT
    31 00000986 C70500100000032000- <1>     mov dword [PML4_ADDR], PDPT_ADDR | PAGE_FLAGS
    31 0000098F 00                  <1>
    32                              <1> 
    33                              <1>     ; PDPT[0..3] → PD0..PD3
    34 00000990 C70500200000033000- <1>     mov dword [PDPT_ADDR + 0*8], PD0_ADDR | PAGE_FLAGS
    34 00000999 00                  <1>
    35 0000099A C70508200000034000- <1>     mov dword [PDPT_ADDR + 1*8], PD1_ADDR | PAGE_FLAGS
    35 000009A3 00                  <1>
    36 000009A4 C70510200000035000- <1>     mov dword [PDPT_ADDR + 2*8], PD2_ADDR | PAGE_FLAGS
    36 000009AD 00                  <1>
    37 000009AE C70518200000036000- <1>     mov dword [PDPT_ADDR + 3*8], PD3_ADDR | PAGE_FLAGS
    37 000009B7 00                  <1>
    38                              <1> 
    39                              <1>     ; PD0: 0x00000000 - 0x3FFFFFFF (512 × 2MB pages)
    40 000009B8 BF00300000          <1>     mov edi, PD0_ADDR
    41 000009BD B883000000          <1>     mov eax, PAGE_HUGE_FLAGS
    42 000009C2 B900020000          <1>     mov ecx, 512
    43                              <1> .fill_pd0:
    44 000009C7 8907                <1>     mov [edi], eax
    45 000009C9 0500002000          <1>     add eax, 0x200000
    46 000009CE 83C708              <1>     add edi, 8
    47 000009D1 E2F4                <1>     loop .fill_pd0
    48                              <1> 
    49                              <1>     ; PD1: 0x40000000 - 0x7FFFFFFF
    50 000009D3 BF00400000          <1>     mov edi, PD1_ADDR
    51 000009D8 B883000040          <1>     mov eax, 0x40000000 | PAGE_HUGE_FLAGS
    52 000009DD B900020000          <1>     mov ecx, 512
    53                              <1> .fill_pd1:
    54 000009E2 8907                <1>     mov [edi], eax
    55 000009E4 0500002000          <1>     add eax, 0x200000
    56 000009E9 83C708              <1>     add edi, 8
    57 000009EC E2F4                <1>     loop .fill_pd1
    58                              <1> 
    59                              <1>     ; PD2: 0x80000000 - 0xBFFFFFFF
    60 000009EE BF00500000          <1>     mov edi, PD2_ADDR
    61 000009F3 B883000080          <1>     mov eax, 0x80000000 | PAGE_HUGE_FLAGS
    62 000009F8 B900020000          <1>     mov ecx, 512
    63                              <1> .fill_pd2:
    64 000009FD 8907                <1>     mov [edi], eax
    65 000009FF 0500002000          <1>     add eax, 0x200000
    66 00000A04 83C708              <1>     add edi, 8
    67 00000A07 E2F4                <1>     loop .fill_pd2
    68                              <1> 
    69                              <1>     ; PD3: 0xC0000000 - 0xFFFFFFFF
    70 00000A09 BF00600000          <1>     mov edi, PD3_ADDR
    71 00000A0E B8830000C0          <1>     mov eax, 0xC0000000 | PAGE_HUGE_FLAGS
    72 00000A13 B900020000          <1>     mov ecx, 512
    73                              <1> .fill_pd3:
    74 00000A18 8907                <1>     mov [edi], eax
    75 00000A1A 0500002000          <1>     add eax, 0x200000
    76 00000A1F 83C708              <1>     add edi, 8
    77 00000A22 E2F4                <1>     loop .fill_pd3
    78                              <1> 
    79 00000A24 C3                  <1>     ret
