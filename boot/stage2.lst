   328                                  ; ── 64-bit Long Mode ────────────────────────────────────────────────────
   329                                  
   330                                  [BITS 64]
   331                                  DEFAULT ABS
   332                                  
   333                                  %include "sse_avx.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS SSE + AVX + AVX2 Initialization (64-bit)
     3                              <1> ; ============================================================================
     4                              <1> ; Ryzen 5 5600X: SSE→SSE2→SSE3→SSSE3→SSE4.1→SSE4.2→AVX→AVX2→FMA3
     5                              <1> ;
     6                              <1> ; 1. Enable SSE  (CR0.EM=0, CR0.MP=1, CR4.OSFXSR, CR4.OSXMMEXCPT)
     7                              <1> ; 2. Enable XSAVE (CR4.OSXSAVE)
     8                              <1> ; 3. Enable AVX via XCR0 (bits 0+1+2 = x87 + SSE + AVX)
     9                              <1> ; 4. AVX2/FMA3 usable after AVX enabled
    10                              <1> ; ============================================================================
    11                              <1> 
    12                              <1> [BITS 64]
    13                              <1> 
    14                              <1> init_sse_avx:
    15                              <1>     ; Enable SSE
    16 00000B29 0F20C0              <1>     mov rax, cr0
    17 00000B2C 6683E0FB            <1>     and ax, 0xFFFB              ; Clear CR0.EM (bit 2)
    18 00000B30 6683C802            <1>     or ax, 0x0002               ; Set CR0.MP (bit 1)
    19 00000B34 0F22C0              <1>     mov cr0, rax
    20                              <1> 
    21 00000B37 0F20E0              <1>     mov rax, cr4
    22 00000B3A 660D0002            <1>     or ax, (1 << 9)             ; CR4.OSFXSR
    23 00000B3E 660D0004            <1>     or ax, (1 << 10)            ; CR4.OSXMMEXCPT
    24 00000B42 0F22E0              <1>     mov cr4, rax
    25                              <1> 
    26                              <1>     ; Enable XSAVE
    27 00000B45 0F20E0              <1>     mov rax, cr4
    28 00000B48 480D00000400        <1>     or rax, (1 << 18)           ; CR4.OSXSAVE
    29 00000B4E 0F22E0              <1>     mov cr4, rax
    30                              <1> 
    31                              <1>     ; Enable AVX via XCR0
    32 00000B51 4831C9              <1>     xor rcx, rcx
    33 00000B54 0F01D0              <1>     xgetbv
    34 00000B57 83C807              <1>     or eax, 0x07                ; x87 + SSE + AVX
    35 00000B5A 0F01D1              <1>     xsetbv
    36                              <1> 
    37 00000B5D C3                  <1>     ret
    38                              <1> 
    39                              <1> ; AVX2 self-test
    40                              <1> avx2_selftest:
    41 00000B5E C5FD76C0            <1>     db 0xC5, 0xFD, 0x76, 0xC0      ; vpcmpeqd ymm0, ymm0, ymm0
    42 00000B62 C4E27D17C0          <1>     db 0xC4, 0xE2, 0x7D, 0x17, 0xC0 ; vptest ymm0, ymm0
    43 00000B67 C3                  <1>     ret
