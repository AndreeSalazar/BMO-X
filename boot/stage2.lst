    76                              <1> 
    77                              <1> [BITS 16]
    78 00000156 5B466173744F535D20- <1> msg_no_cpuid: db "[FastOS] ERROR: No CPUID", 13, 10, 0
    78 0000015F 4552524F523A204E6F- <1>
    78 00000168 2043505549440D0A00  <1>
    79 00000171 5B466173744F535D20- <1> msg_no_lm:    db "[FastOS] ERROR: No Long Mode", 13, 10, 0
    79 0000017A 4552524F523A204E6F- <1>
    79 00000183 204C6F6E67204D6F64- <1>
    79 0000018C 650D0A00            <1>
