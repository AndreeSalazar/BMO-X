    45                                  stage2_start:
    46                                      ; ── CRITICAL: Save boot drive (DL) IMMEDIATELY ───────────────────────
    47                                      ; BIOS sets DL=0x80 (first hard drive) on boot. Save it NOW before
    48                                      ; any code execution to prevent corruption.
    49 000005AC 8816[5A08]                  mov [stage2_boot_drive], dl
    50                                  
    51                                      ; ── Ultra-early VGA diagnostic ───────────────────────────────────────
    52                                      ; Write "S2" directly to VGA text buffer at bottom-left (row 24).
    53                                      ; This proves Stage2 code is executing, even if INT 10h or segments
    54                                      ; are broken. If you see "S2" on screen but no Stage2 messages,
    55                                      ; the crash is happening between here and the first print_string_16.
    56 000005B0 B800B8                      mov ax, 0xB800
    57 000005B3 8EC0                        mov es, ax
    58 000005B5 26C706000F534F              mov word [es:3840], 0x4F53      ; 'S' white-on-red, row 24, col 0
    59 000005BC 26C706020F324F              mov word [es:3842], 0x4F32      ; '2' white-on-red, row 24, col 1
    60                                  
    61                                      ; ── Phase 1: 16-bit Real Mode ────────────────────────────────────────
    62                                  
    63 000005C3 FA                          cli
    64 000005C4 31C0                        xor ax, ax
    65 000005C6 8ED8                        mov ds, ax
    66 000005C8 8EC0                        mov es, ax
    67 000005CA 8ED0                        mov ss, ax
    68 000005CC BC007C                      mov sp, 0x7C00
    69 000005CF FB                          sti
    70                                  
    71 000005D0 BE[CB06]                    mov si, msg_s2_start
    72 000005D3 E8C5FF                      call print_string_16
    73                                  
    74                                      ; CPU checks
