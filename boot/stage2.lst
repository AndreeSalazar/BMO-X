    99 00000347 00                  <1> vbe_mode_ok:  db 0
    24                                  %include "payload_loader.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS Payload Loader — Real Mode Only (No Unreal Mode)
     3                              <1> ; ============================================================================
     4                              <1> ; Target: RTX 3060 12GB (GA106)
     5                              <1> ; Board: MSI MS-7C52 (B550), AMI Aptio V BIOS (DL=0x0E for USB)
     6                              <1> ;
     7                              <1> ; DESIGN: Load firmware using plain real-mode INT 13h only.
     8                              <1> ;   - NO Unreal Mode (causes triple fault on AMI Aptio V CSM)
     9                              <1> ;   - NO lgdt/CR0 toggle in real mode
    10                              <1> ;   - Read 32KB chunks to buffer at 0x20000 (segment 0x2000)
    11                              <1> ;   - Copy to 0x1000000 is done later in Protected Mode by stage2
    12                              <1> ;   - This function ONLY reads to low memory and records metadata
    13                              <1> ;
    14                              <1> ; CONSTRAINTS: NASM -f bin flat binary, no sections, no extern
    15                              <1> ; ============================================================================
    16                              <1> 
    17                              <1> [BITS 16]
    18                              <1> 
    19                              <1> ; ── Constants ───────────────────────────────────────────────────────────────
    20                              <1> PL_GSP_LBA_START   equ 1000           ; LBA where GSP firmware starts on disk
    21                              <1> PL_GSP_SECTORS     equ 142276         ; 72845296 / 512 = 142276.75 → 142277 sectors
    22                              <1> PL_GSP_SIZE        equ 72845296       ; Exact size in bytes
    23                              <1> PL_CHUNK_SECTORS   equ 64             ; 64 sectors = 32KB per INT 13h call
    24                              <1> PL_CHUNK_BYTES     equ 32768          ; 64 * 512
    25                              <1> PL_BUFFER_SEG      equ 0x2000         ; Segment 0x2000 = phys 0x20000
    26                              <1> PL_TOTAL_CHUNKS    equ 2223           ; 142277 / 64 = 2223.078 → 2223 full + 1 partial
    27                              <1> PL_LAST_SECTORS    equ 5              ; 142277 - (2223 * 64) = 142277 - 142272 = 5
    28                              <1> 
    29                              <1> ; ── Entry point ─────────────────────────────────────────────────────────────
    30                              <1> ; Called from stage2.asm with: call load_payloads
    31                              <1> ; On return: payload_base/size set, firmware is at 0x20000..0x4FFFF area
    32                              <1> ;   (only last chunk remains in buffer — full copy to 0x1000000 done in PM)
    33                              <1> ; Actually: we record LBA/size info. PM code does the streaming copy.
    34                              <1> load_payloads:
    35 00000348 60                  <1>     pusha
    36 00000349 8926[B004]          <1>     mov [pl_saved_sp], sp
    37                              <1> 
