   170 0000045D 6766F3A5            <1>     a32 rep movsd
   171                              <1> 
   172                              <1>     ; ── Advance to next block ─────────────────────────────────────────────
   173 00000461 66A1[5405]          <1>     mov eax, [pl_dest_addr]
   174 00000465 660500200000        <1>     add eax, BLOCK_SIZE
   175 0000046B 66A3[5405]          <1>     mov [pl_dest_addr], eax
   176                              <1> 
   177 0000046F 66A1[6405]          <1>     mov eax, [pl_dap_lba]
   178 00000473 6683C010            <1>     add eax, SECTORS_PER_BLOCK
   179 00000477 66A3[6405]          <1>     mov [pl_dap_lba], eax
   180                              <1> 
   181 0000047B FF0E[5805]          <1>     dec word [pl_remain]
