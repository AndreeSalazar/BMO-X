    43                                  stage2_start:
    44                                      ; ── Phase 1: 16-bit Real Mode ────────────────────────────────────────
    45                                  
    46 000001A1 FA                          cli
    47 000001A2 31C0                        xor ax, ax
    48 000001A4 8ED8                        mov ds, ax
    49 000001A6 8EC0                        mov es, ax
    50 000001A8 8ED0                        mov ss, ax
    51 000001AA BC007C                      mov sp, 0x7C00
    52 000001AD FB                          sti
    53                                  
    54                                      ; Save boot drive from stage1 (DL preserved across jmp)
    55 000001AE 8816[1803]                  mov [stage2_boot_drive], dl
    56                                  
    57 000001B2 BE[1802]                    mov si, msg_s2_start
    58 000001B5 E8D8FF                      call print_string_16
    59                                  
    60                                      ; CPU checks
    61 000001B8 E814FF                      call check_cpuid
    62 000001BB BE[3402]                    mov si, msg_cpuid_ok
    63 000001BE E8CFFF                      call print_string_16
    64                                  
    65 000001C1 E832FF                      call check_long_mode
    66 000001C4 BE[4902]                    mov si, msg_lm_ok
    67 000001C7 E8C6FF                      call print_string_16
    68                                  
    69                                      ; Enable A20
    70 000001CA E876FE                      call enable_a20
    71 000001CD BE[6202]                    mov si, msg_a20_ok
