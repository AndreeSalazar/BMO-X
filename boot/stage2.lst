   336 00000B68 66B81000                    mov ax, GDT64_DATA_SEG
   337 00000B6C 8ED8                        mov ds, ax
   338 00000B6E 8EC0                        mov es, ax
   339 00000B70 8EE0                        mov fs, ax
   340 00000B72 8EE8                        mov gs, ax
   341 00000B74 8ED0                        mov ss, ax
   342 00000B76 BC00008000                  mov rsp, 0x800000
