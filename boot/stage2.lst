    23                                  %include "vbe.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS VBE — VESA BIOS Extensions for 1920×1080 framebuffer
     3                              <1> ; ============================================================================
     4                              <1> ; Sets 1920×1080×32bpp mode using INT 10h AX=4F02h (VBE 2.0+).
     5                              <1> ; The GPU's VBIOS (loaded by MSI B550 CSM) provides VBE support.
     6                              <1> ;
     7                              <1> ; Output:
     8                              <1> ;   [vbe_fb_addr]   = u32 physical address of linear framebuffer
     9                              <1> ;   [vbe_mode_ok]   = 1 if mode set succeeded, 0 if fallback to VGA text
    10                              <1> ; ============================================================================
    11                              <1> 
    12                              <1> [BITS 16]
    13                              <1> 
    14                              <1> VBE_INFO_BLOCK  equ 0x7000     ; Temporary buffer for VBE info (512 bytes)
    15                              <1> VBE_MODE_INFO   equ 0x7200     ; Temporary buffer for mode info (256 bytes)
    16                              <1> 
    17                              <1> ; Desired mode parameters
    18                              <1> VBE_WANT_WIDTH  equ 1920
    19                              <1> VBE_WANT_HEIGHT equ 1080
    20                              <1> VBE_WANT_BPP    equ 32
    21                              <1> 
    22                              <1> setup_vbe:
    23                              <1>     ; ── Step 1: Get VBE controller info ──────────────────────────────
    24 000002AA B8004F              <1>     mov ax, 0x4F00
    25 000002AD BF0070              <1>     mov di, VBE_INFO_BLOCK
    26 000002B0 66C70556424532      <1>     mov dword [di], 'VBE2'     ; Request VBE 2.0+ info
    27 000002B7 CD10                <1>     int 0x10
    28 000002B9 83F84F              <1>     cmp ax, 0x004F
    29 000002BC 756E                <1>     jne .vbe_fail               ; VBE not supported
    30                              <1> 
    31                              <1>     ; ── Step 2: Walk mode list to find 1920×1080×32bpp ──────────────
    32                              <1>     ; Mode list pointer is at VBE_INFO_BLOCK + 14 (far pointer seg:off)
    33 000002BE 8B360E70            <1>     mov si, [VBE_INFO_BLOCK + 14]    ; offset
    34 000002C2 A11070              <1>     mov ax, [VBE_INFO_BLOCK + 16]    ; segment
    35 000002C5 8EE0                <1>     mov fs, ax                        ; FS:SI = mode list
    36                              <1> 
    37                              <1> .scan_modes:
    38 000002C7 648B0C              <1>     mov cx, [fs:si]
    39 000002CA 83F9FF              <1>     cmp cx, 0xFFFF                    ; End of mode list
    40 000002CD 745D                <1>     je .vbe_fail
    41 000002CF 83C602              <1>     add si, 2
    42                              <1> 
    43                              <1>     ; Get info for this mode
    44 000002D2 56                  <1>     push si
    45 000002D3 51                  <1>     push cx
    46 000002D4 B8014F              <1>     mov ax, 0x4F01
    47 000002D7 BF0072              <1>     mov di, VBE_MODE_INFO
    48 000002DA CD10                <1>     int 0x10
