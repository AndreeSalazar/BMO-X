    83 000001E2 B442                        mov ah, 0x42
    84 000001E4 8A16[1803]                  mov dl, [stage2_boot_drive]
    85 000001E8 BE[1C03]                    mov si, dap_kernel
    86 000001EB CD13                        int 0x13
    87 000001ED 7221                        jc .kernel_load_err
    88                                  
    89 000001EF BE[B702]                    mov si, msg_kernel_loaded
    90 000001F2 E89BFF                      call print_string_16
    91                                  
    92                                      ; ── Phase 2: Enter 32-bit Protected Mode ─────────────────────────────
    93                                  
    94 000001F5 BE[F202]                    mov si, msg_entering_pm
    95 000001F8 E895FF                      call print_string_16
    96                                  
    97 000001FB FA                          cli
    98 000001FC 0F0116[1B00]                lgdt [gdt32_descriptor]
    99                                  
