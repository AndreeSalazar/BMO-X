   396                                      ; ── Build boot info for Rust kernel ──────────────────────────────────
   397                                  
   398                                      ; Boot info at 0x9100 (passed in RDI to Rust)
   399 00000C1B 48C704250091000005-         mov qword [0x9100], 0xFA5705           ; magic
   399 00000C24 57FA00             
   400 00000C27 48C704250891000000-         mov qword [0x9108], 0x8000             ; memory_map_addr
   400 00000C30 800000             
   401 00000C33 8B042500800000              mov eax, [0x8000]
   402 00000C3A 4889042510910000            mov qword [0x9110], rax                ; memory_map_count
   403 00000C42 48C704251891000000-         mov qword [0x9118], 0x9000             ; cpu_features_addr
   403 00000C4B 900000             
   404                                  
   405                                      ; Framebuffer: use VBE address if set, otherwise VGA 0xB8000
   406 00000C4E 8B0425[41030000]            mov eax, [vbe_fb_addr]
   407 00000C55 4889042520910000            mov qword [0x9120], rax                ; framebuffer_addr
   408 00000C5D 48C704252891000000-         mov qword [0x9128], 0x100000           ; kernel_start
   408 00000C66 001000             
   409 00000C69 48C704253091000000-         mov qword [0x9130], 132 * 1024         ; kernel_size (132KB)
   409 00000C72 100200             
   410                                  
   411                                      ; Extended boot info: VBE data
   412 00000C75 0FB70425[45030000]          movzx eax, word [vbe_pitch]
   413 00000C7D 4889042538910000            mov qword [0x9138], rax                ; fb_pitch
   414 00000C85 0FB60425[47030000]          movzx eax, byte [vbe_mode_ok]
   415 00000C8D 4889042540910000            mov qword [0x9140], rax                ; vbe_mode (1=graphics, 0=text)
   416                                  
   417                                      ; Extended boot info: GSP Firmware (loaded by payload_loader.asm)
   418 00000C95 8B0425[41050000]            mov eax, dword [payload_base]
   419 00000C9C 4889042548910000            mov qword [0x9148], rax                ; gpu_fw_addr
   420 00000CA4 8B0425[49050000]            mov eax, dword [payload_size]
   421 00000CAB 4889042550910000            mov qword [0x9150], rax                ; gpu_fw_size
   422                                  
   423                                      ; ── Jump to Rust kernel with System V AMD64 ABI arguments ─────────────
   424                                      ; RDI = GSP firmware address (0x1000000)
   425                                      ; RSI = GSP firmware size (72845296)
   426                                      ; RDX = memory map pointer (0x8000)
   427                                  
   428 00000CB3 BF00000001                  mov rdi, 0x1000000              ; GSP firmware address
   429 00000CB8 BEF0875704                  mov rsi, 72845296               ; GSP firmware size
   430 00000CBD BA00800000                  mov rdx, 0x8000                 ; Memory map pointer
   431                                  
   432 00000CC2 B800001000                  mov rax, 0x100000              ; Kernel entry point
   433 00000CC7 FFE0                        jmp rax
   434                                  
   435 00000CC9 FA                          cli
   436 00000CCA F4                          hlt
