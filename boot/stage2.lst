   347 00000B88 4869C0A0000000              imul rax, 160
   348 00000B8F 480500800B00                add rax, 0xB8000
   349 00000B95 4889C7                      mov rdi, rax
   350 00000B98 48BE-                       mov rsi, msg_lm_active
   350 00000B9A [CB0C000000000000] 
   351 00000BA2 B40E                        mov ah, 0x0E                    ; yellow on black
   352                                  .lm_print:
   353 00000BA4 AC                          lodsb
   354 00000BA5 84C0                        test al, al
