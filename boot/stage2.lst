    82 0000031A C706[4503]0000      <1>     mov word [vbe_pitch], 0
    83 00000320 A11072              <1>     mov ax, [VBE_MODE_INFO + 16]      ; BytesPerScanLine
    84 00000323 A3[4503]            <1>     mov [vbe_pitch], ax
    85 00000326 C606[4703]01        <1>     mov byte [vbe_mode_ok], 1
    86                              <1> 
    87 0000032B C3                  <1>     ret
    88                              <1> 
    89                              <1> .vbe_fail:
    90                              <1>     ; VBE failed — stay in VGA text mode (80×25)
    91 0000032C C606[4703]00        <1>     mov byte [vbe_mode_ok], 0
    92 00000331 66C706[4103]00800B- <1>     mov dword [vbe_fb_addr], 0xB8000
    92 00000339 00                  <1>
    93 0000033A C706[4503]A000      <1>     mov word [vbe_pitch], 160         ; 80 * 2 for VGA text
    94 00000340 C3                  <1>     ret
