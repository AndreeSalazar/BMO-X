     1                                  ; ============================================================================
     2                                  ; FastOS Stage 2 — Real Mode → Protected Mode → Long Mode
     3                                  ; ============================================================================
     4                                  ; Loaded at 0x7E00 by Stage 1.
     5                                  ; Full transition: 16-bit → 32-bit → 64-bit → Rust kernel.
     6                                  ; Target: AMD Ryzen 5 5600X (Zen 3, Vermeer)
     7                                  ; Board:  MSI MAG B550 TOMAHAWK (MS-7C52) — UEFI CSM quirks handled.
     8                                  ; ============================================================================
     9                                  
    10                                  [BITS 16]
    11                                  [ORG 0x7E00]
    12                                  
    13                                  ; ── Entry vector ─────────────────────────────────────────────────────────
    14                                  ; BYTE 0 of stage2.bin — Stage1 jumps here (0x7E00).
    15                                  ; Must be the absolute first instruction. Everything else comes after.
    16 00000000 E9A905                  jmp stage2_start
    17                                  
    18                                  ; ── Includes (data tables + subroutines, NOT entry points) ──────────────
    19                                  %include "gdt.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS GDT — Global Descriptor Table (32-bit + 64-bit)
     3                              <1> ; ============================================================================
     4                              <1> 
     5                              <1> [BITS 16]
     6                              <1> 
     7                              <1> ; ── 32-bit GDT (protected mode transition) ──────────────────────────────────
     8                              <1> 
     9                              <1> gdt32_start:
    10 00000003 0000000000000000    <1>     dq 0x0000000000000000           ; Null descriptor
    11                              <1> 
    12                              <1> gdt32_code:
    13 0000000B FFFF                <1>     dw 0xFFFF                       ; Limit low
    14 0000000D 0000                <1>     dw 0x0000                       ; Base low
    15 0000000F 00                  <1>     db 0x00                         ; Base mid
    16 00000010 9A                  <1>     db 10011010b                    ; Access: P=1, Ring0, Code, Exec/Read
    17 00000011 CF                  <1>     db 11001111b                    ; Flags: 4KB gran, 32-bit + Limit high
    18 00000012 00                  <1>     db 0x00                         ; Base high
    19                              <1> 
    20                              <1> gdt32_data:
    21 00000013 FFFF                <1>     dw 0xFFFF
    22 00000015 0000                <1>     dw 0x0000
    23 00000017 00                  <1>     db 0x00
    24 00000018 92                  <1>     db 10010010b                    ; Access: P=1, Ring0, Data, R/W
    25 00000019 CF                  <1>     db 11001111b
    26 0000001A 00                  <1>     db 0x00
    27                              <1> 
    28                              <1> gdt32_end:
    29                              <1> 
    30                              <1> gdt32_descriptor:
    31 0000001B 1700                <1>     dw gdt32_end - gdt32_start - 1
    32 0000001D [03000000]          <1>     dd gdt32_start
    33                              <1> 
    34                              <1> GDT32_CODE_SEG equ gdt32_code - gdt32_start   ; 0x08
    35                              <1> GDT32_DATA_SEG equ gdt32_data - gdt32_start   ; 0x10
    36                              <1> 
    37                              <1> ; ── 64-bit GDT (long mode) ──────────────────────────────────────────────────
    38                              <1> 
    39                              <1> gdt64_start:
    40 00000021 0000000000000000    <1>     dq 0x0000000000000000           ; Null descriptor
    41                              <1> 
    42                              <1> gdt64_code:
    43 00000029 0000                <1>     dw 0x0000                       ; Limit (ignored in long mode)
    44 0000002B 0000                <1>     dw 0x0000                       ; Base low
    45 0000002D 00                  <1>     db 0x00                         ; Base mid
    46 0000002E 9A                  <1>     db 10011010b                    ; Access: P=1, Ring0, Code, Exec/Read
    47 0000002F 20                  <1>     db 00100000b                    ; Flags: Long mode (bit 5)
    48 00000030 00                  <1>     db 0x00                         ; Base high
    49                              <1> 
    50                              <1> gdt64_data:
    51 00000031 0000                <1>     dw 0x0000
    52 00000033 0000                <1>     dw 0x0000
    53 00000035 00                  <1>     db 0x00
    54 00000036 92                  <1>     db 10010010b                    ; Access: P=1, Ring0, Data, R/W
    55 00000037 00                  <1>     db 00000000b
    56 00000038 00                  <1>     db 0x00
    57                              <1> 
    58                              <1> gdt64_end:
    59                              <1> 
    60                              <1> gdt64_descriptor:
    61 00000039 1700                <1>     dw gdt64_end - gdt64_start - 1
    62 0000003B [21000000]          <1>     dd gdt64_start                     ; Patched at runtime in 32-bit PM
    63 0000003F 00000000            <1>     dd 0                               ; High 32 bits (zero for identity map)
    64                              <1> 
    65                              <1> GDT64_CODE_SEG equ gdt64_code - gdt64_start   ; 0x08
    66                              <1> GDT64_DATA_SEG equ gdt64_data - gdt64_start   ; 0x10
    20                                  %include "a20.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS A20 Line Enable
     3                              <1> ; ============================================================================
     4                              <1> ; Must be enabled to access memory above 1MB.
     5                              <1> ; Tries: BIOS → keyboard controller → fast A20 (port 0x92).
     6                              <1> ; ============================================================================
     7                              <1> 
     8                              <1> [BITS 16]
     9                              <1> 
    10                              <1> enable_a20:
    11                              <1>     ; Method 1: BIOS
    12 00000043 B80124              <1>     mov ax, 0x2401
    13 00000046 CD15                <1>     int 0x15
    14 00000048 7335                <1>     jnc .a20_done
    15                              <1> 
    16                              <1>     ; Method 2: Keyboard controller
    17 0000004A E83300              <1>     call .a20_wait_input
    18 0000004D B0AD                <1>     mov al, 0xAD
    19 0000004F E664                <1>     out 0x64, al
    20 00000051 E82C00              <1>     call .a20_wait_input
    21 00000054 B0D0                <1>     mov al, 0xD0
    22 00000056 E664                <1>     out 0x64, al
    23 00000058 E82C00              <1>     call .a20_wait_output
    24 0000005B E460                <1>     in al, 0x60
    25 0000005D 50                  <1>     push ax
    26 0000005E E81F00              <1>     call .a20_wait_input
    27 00000061 B0D1                <1>     mov al, 0xD1
    28 00000063 E664                <1>     out 0x64, al
    29 00000065 E81800              <1>     call .a20_wait_input
    30 00000068 58                  <1>     pop ax
    31 00000069 0C02                <1>     or al, 0x02
    32 0000006B E660                <1>     out 0x60, al
    33 0000006D E81000              <1>     call .a20_wait_input
    34 00000070 B0AE                <1>     mov al, 0xAE
    35 00000072 E664                <1>     out 0x64, al
    36 00000074 E80900              <1>     call .a20_wait_input
    37                              <1> 
    38                              <1>     ; Method 3: Fast A20
    39 00000077 E492                <1>     in al, 0x92
    40 00000079 0C02                <1>     or al, 0x02
    41 0000007B 24FE                <1>     and al, 0xFE
    42 0000007D E692                <1>     out 0x92, al
    43                              <1> 
    44                              <1> .a20_done:
    45 0000007F C3                  <1>     ret
    46                              <1> 
    47                              <1> .a20_wait_input:
    48 00000080 E464                <1>     in al, 0x64
    49 00000082 A802                <1>     test al, 0x02
    50 00000084 75FA                <1>     jnz .a20_wait_input
    51 00000086 C3                  <1>     ret
    52                              <1> 
    53                              <1> .a20_wait_output:
    54 00000087 E464                <1>     in al, 0x64
    55 00000089 A801                <1>     test al, 0x01
    56 0000008B 74FA                <1>     jz .a20_wait_output
    57 0000008D C3                  <1>     ret
    21                                  %include "memory.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS Memory Detection — E801h + Fallback
     3                              <1> ; ============================================================================
     4                              <1> ; E820 hangs on this UEFI CSM (Ryzen 5 5600X motherboard, USB boot).
     5                              <1> ; Use INT 15h AX=E801h instead — simpler, more compatible.
     6                              <1> ;
     7                              <1> ; If E801h also fails, hardcode a conservative memory map.
     8                              <1> ; The kernel can refine this later via ACPI tables.
     9                              <1> ;
    10                              <1> ; Output: memory map at 0x8000 in same format kernel expects:
    11                              <1> ;   [0x8000]      = u32 count
    12                              <1> ;   [0x8004+n*24] = { base_u64, length_u64, type_u32, attrs_u32 }
    13                              <1> ; ============================================================================
    14                              <1> 
    15                              <1> [BITS 16]
    16                              <1> 
    17                              <1> MEMORY_MAP_ADDR  equ 0x8000
    18                              <1> MEMORY_MAP_COUNT equ 0x8000    ; First 4 bytes = count
    19                              <1> 
    20                              <1> detect_memory_e820:
    21 0000008E 6660                <1>     pushad
    22                              <1> 
    23                              <1>     ; ── Try INT 15h AX=E801h ────────────────────────────────────────────
    24                              <1>     ; Returns extended memory in two ranges:
    25                              <1>     ;   AX/CX = memory between 1MB-16MB in 1KB blocks
    26                              <1>     ;   BX/DX = memory above 16MB in 64KB blocks
    27                              <1>     ; More compatible than E820 on UEFI CSM.
    28                              <1> 
    29 00000090 B801E8              <1>     mov ax, 0xE801
    30 00000093 CD15                <1>     int 0x15
    31 00000095 0F82D300            <1>     jc .e801_fail               ; CF = not supported
    32 00000099 83F800              <1>     cmp ax, 0                   ; Some BIOS return 0 in AX
    33 0000009C 7402                <1>     je .try_cx                  ; Try CX instead
    34                              <1> 
    35                              <1>     ; AX = 1KB blocks between 1MB-16MB
    36                              <1>     ; BX = 64KB blocks above 16MB
    37 0000009E EB0B                <1>     jmp .e801_build
    38                              <1> 
    39                              <1> .try_cx:
    40                              <1>     ; Some BIOS put the result in CX/DX instead of AX/BX
    41 000000A0 89C8                <1>     mov ax, cx
    42 000000A2 89D3                <1>     mov bx, dx
    43 000000A4 83F800              <1>     cmp ax, 0
    44 000000A7 0F84C100            <1>     je .e801_fail               ; Both AX and CX are 0 — fail
    45                              <1> 
    46                              <1> .e801_build:
    47                              <1>     ; AX = KB between 1MB-16MB, BX = 64KB blocks above 16MB
    48                              <1>     ; Build a memory map the kernel understands
    49                              <1> 
    50 000000AB 66C706008000000000  <1>     mov dword [MEMORY_MAP_ADDR], 0  ; Reset count
    51 000000B4 BF0480              <1>     mov di, MEMORY_MAP_ADDR + 4
    52                              <1> 
    53                              <1>     ; ── Entry 0: Conventional memory 0x00000 - 0x9FC00 (639KB) ────────
    54 000000B7 66C70500000000      <1>     mov dword [di +  0], 0x00000000  ; base low
    55 000000BE 66C7450400000000    <1>     mov dword [di +  4], 0x00000000  ; base high
    56 000000C6 66C7450800FC0900    <1>     mov dword [di +  8], 0x0009FC00  ; length low (639KB)
    57 000000CE 66C7450C00000000    <1>     mov dword [di + 12], 0x00000000  ; length high
    58 000000D6 66C7451001000000    <1>     mov dword [di + 16], 1           ; type = usable
    59 000000DE 66C7451400000000    <1>     mov dword [di + 20], 0           ; attrs
    60 000000E6 83C718              <1>     add di, 24
    61 000000E9 66FF060080          <1>     inc dword [MEMORY_MAP_ADDR]
    62                              <1> 
    63                              <1>     ; ── Entry 1: Extended memory 1MB to 1MB+AX*1024 ──────────────────
    64                              <1>     ; AX still holds KB between 1MB-16MB
    65 000000EE 660FB7C0            <1>     movzx eax, ax
    66 000000F2 66C1E00A            <1>     shl eax, 10                      ; AX * 1024 = bytes
    67 000000F6 66C70500001000      <1>     mov dword [di +  0], 0x00100000  ; base = 1MB
    68 000000FD 66C7450400000000    <1>     mov dword [di +  4], 0x00000000
    69 00000105 66894508            <1>     mov dword [di +  8], eax         ; length = AX KB
    70 00000109 66C7450C00000000    <1>     mov dword [di + 12], 0x00000000
    71 00000111 66C7451001000000    <1>     mov dword [di + 16], 1           ; type = usable
    72 00000119 66C7451400000000    <1>     mov dword [di + 20], 0
    73 00000121 83C718              <1>     add di, 24
    74 00000124 66FF060080          <1>     inc dword [MEMORY_MAP_ADDR]
    75                              <1> 
    76                              <1>     ; ── Entry 2: Memory above 16MB (if BX > 0) ──────────────────────
    77 00000129 83FB00              <1>     cmp bx, 0
    78 0000012C 743B                <1>     je .e801_done
    79                              <1> 
    80 0000012E 660FB7DB            <1>     movzx ebx, bx
    81 00000132 66C1E310            <1>     shl ebx, 16                      ; BX * 64KB = bytes
    82 00000136 66C70500000001      <1>     mov dword [di +  0], 0x01000000  ; base = 16MB
    83 0000013D 66C7450400000000    <1>     mov dword [di +  4], 0x00000000
    84 00000145 66895D08            <1>     mov dword [di +  8], ebx         ; length low
    85 00000149 66C7450C00000000    <1>     mov dword [di + 12], 0x00000000
    86 00000151 66C7451001000000    <1>     mov dword [di + 16], 1           ; type = usable
    87 00000159 66C7451400000000    <1>     mov dword [di + 20], 0
    88 00000161 83C718              <1>     add di, 24
    89 00000164 66FF060080          <1>     inc dword [MEMORY_MAP_ADDR]
    90                              <1> 
    91                              <1> .e801_done:
    92 00000169 6661                <1>     popad
    93 0000016B C3                  <1>     ret
    94                              <1> 
    95                              <1>     ; ── Fallback: hardcoded conservative map ────────────────────────────
    96                              <1>     ; If E801h fails, assume at least 256MB (safe for Ryzen 5 5600X).
    97                              <1> .e801_fail:
    98 0000016C 66C706008000000000  <1>     mov dword [MEMORY_MAP_ADDR], 0
    99 00000175 BF0480              <1>     mov di, MEMORY_MAP_ADDR + 4
   100                              <1> 
   101                              <1>     ; Entry 0: Conventional 0 - 640KB
   102 00000178 66C70500000000      <1>     mov dword [di +  0], 0x00000000
   103 0000017F 66C7450400000000    <1>     mov dword [di +  4], 0x00000000
   104 00000187 66C7450800000A00    <1>     mov dword [di +  8], 0x000A0000  ; 640KB
   105 0000018F 66C7450C00000000    <1>     mov dword [di + 12], 0x00000000
   106 00000197 66C7451001000000    <1>     mov dword [di + 16], 1
   107 0000019F 66C7451400000000    <1>     mov dword [di + 20], 0
   108 000001A7 83C718              <1>     add di, 24
   109 000001AA 66FF060080          <1>     inc dword [MEMORY_MAP_ADDR]
   110                              <1> 
   111                              <1>     ; Entry 1: Extended 1MB - 256MB (conservative for 16GB+ system)
   112 000001AF 66C70500001000      <1>     mov dword [di +  0], 0x00100000
   113 000001B6 66C7450400000000    <1>     mov dword [di +  4], 0x00000000
   114 000001BE 66C745080000F00F    <1>     mov dword [di +  8], 0x0FF00000  ; 255MB
   115 000001C6 66C7450C00000000    <1>     mov dword [di + 12], 0x00000000
   116 000001CE 66C7451001000000    <1>     mov dword [di + 16], 1
   117 000001D6 66C7451400000000    <1>     mov dword [di + 20], 0
   118 000001DE 83C718              <1>     add di, 24
   119 000001E1 66FF060080          <1>     inc dword [MEMORY_MAP_ADDR]
   120                              <1> 
   121 000001E6 6661                <1>     popad
   122 000001E8 C3                  <1>     ret
    22                                  %include "cpucheck.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS CPU Check — Verify Ryzen 5 5600X capabilities
     3                              <1> ; ============================================================================
     4                              <1> ; Checks: CPUID, Long Mode, SSE, AVX, AVX2, FMA3, AES-NI, SHA, BMI1/2
     5                              <1> ; ============================================================================
     6                              <1> 
     7                              <1> [BITS 16]
     8                              <1> 
     9                              <1> check_cpuid:
    10 000001E9 669C                <1>     pushfd
    11 000001EB 6658                <1>     pop eax
    12 000001ED 6689C1              <1>     mov ecx, eax
    13 000001F0 663500002000        <1>     xor eax, 1 << 21
    14 000001F6 6650                <1>     push eax
    15 000001F8 669D                <1>     popfd
    16 000001FA 669C                <1>     pushfd
    17 000001FC 6658                <1>     pop eax
    18 000001FE 6651                <1>     push ecx
    19 00000200 669D                <1>     popfd
    20 00000202 6639C8              <1>     cmp eax, ecx
    21 00000205 7401                <1>     je .no_cpuid
    22 00000207 C3                  <1>     ret
    23                              <1> .no_cpuid:
    24 00000208 BE[7002]            <1>     mov si, msg_no_cpuid
    25 0000020B E88D03              <1>     call print_string_16
    26 0000020E FA                  <1>     cli
    27 0000020F F4                  <1>     hlt
    28                              <1> 
    29                              <1> check_long_mode:
    30 00000210 66B800000080        <1>     mov eax, 0x80000000
    31 00000216 0FA2                <1>     cpuid
    32 00000218 663D01000080        <1>     cmp eax, 0x80000001
    33 0000021E 7212                <1>     jb .no_long_mode
    34 00000220 66B801000080        <1>     mov eax, 0x80000001
    35 00000226 0FA2                <1>     cpuid
    36 00000228 66F7C200000020      <1>     test edx, 1 << 29
    37 0000022F 7401                <1>     jz .no_long_mode
    38 00000231 C3                  <1>     ret
    39                              <1> .no_long_mode:
    40 00000232 BE[8B02]            <1>     mov si, msg_no_lm
    41 00000235 E86303              <1>     call print_string_16
    42 00000238 FA                  <1>     cli
    43 00000239 F4                  <1>     hlt
    44                              <1> 
    45                              <1> ; ── 32-bit: store CPU features for kernel ────────────────────────────────
    46                              <1> 
    47                              <1> [BITS 32]
    48                              <1> 
    49                              <1> CPU_FEATURES_ADDR equ 0x9000
    50                              <1> 
    51                              <1> ; Layout at 0x9000:
    52                              <1> ;   +0  : CPUID(1) EDX  — SSE(25), SSE2(26)
    53                              <1> ;   +4  : CPUID(1) ECX  — SSE3(0), SSE4.1(19), SSE4.2(20), AVX(28), AES(25), FMA(12)
    54                              <1> ;   +8  : CPUID(7) EBX  — AVX2(5), BMI1(3), BMI2(8), SHA(29)
    55                              <1> ;   +12 : CPUID(7) ECX
    56                              <1> ;   +16 : CPUID(0x80000001) EDX — Long Mode(29), NX(20)
    57                              <1> 
    58                              <1> detect_cpu_features_32:
    59 0000023A B801000000          <1>     mov eax, 1
    60 0000023F 0FA2                <1>     cpuid
    61 00000241 891500900000        <1>     mov [CPU_FEATURES_ADDR + 0], edx
    62 00000247 890D04900000        <1>     mov [CPU_FEATURES_ADDR + 4], ecx
    63                              <1> 
    64 0000024D B807000000          <1>     mov eax, 7
    65 00000252 31C9                <1>     xor ecx, ecx
    66 00000254 0FA2                <1>     cpuid
    67 00000256 891D08900000        <1>     mov [CPU_FEATURES_ADDR + 8], ebx
    68 0000025C 890D0C900000        <1>     mov [CPU_FEATURES_ADDR + 12], ecx
    69                              <1> 
    70 00000262 B801000080          <1>     mov eax, 0x80000001
    71 00000267 0FA2                <1>     cpuid
    72 00000269 891510900000        <1>     mov [CPU_FEATURES_ADDR + 16], edx
    73 0000026F C3                  <1>     ret
    74                              <1> 
    75                              <1> ; ── Messages ─────────────────────────────────────────────────────────────
    76                              <1> 
    77                              <1> [BITS 16]
    78 00000270 5B466173744F535D20- <1> msg_no_cpuid: db "[FastOS] ERROR: No CPUID", 13, 10, 0
    78 00000279 4552524F523A204E6F- <1>
    78 00000282 2043505549440D0A00  <1>
    79 0000028B 5B466173744F535D20- <1> msg_no_lm:    db "[FastOS] ERROR: No Long Mode", 13, 10, 0
    79 00000294 4552524F523A204E6F- <1>
