    76 000005D9 BE[E706]                    mov si, msg_cpuid_ok
    77 000005DC E8BCFF                      call print_string_16
    78                                  
    79 000005DF E82EFC                      call check_long_mode
    80 000005E2 BE[FC06]                    mov si, msg_lm_ok
    81 000005E5 E8B3FF                      call print_string_16
    82                                  
    83                                      ; Enable A20
    84 000005E8 E858FA                      call enable_a20
    85 000005EB BE[1507]                    mov si, msg_a20_ok
    86 000005EE E8AAFF                      call print_string_16
    87                                  
    88                                      ; Detect memory (E801h — E820 hangs on MSI B550 CSM)
    89 000005F1 BE[2D07]                    mov si, msg_e820_try
    90 000005F4 E8A4FF                      call print_string_16
    91                                  
    92 000005F7 E894FA                      call detect_memory_e820
    93 000005FA BE[5407]                    mov si, msg_mem_ok
    94 000005FD E89BFF                      call print_string_16
    95                                  
    96                                      ; ── Load kernel in chunks (64 sectors / 32KB per INT 13h call) ───────
    97                                      ; Total: 257 sectors = 131KB loaded to 0x20000 buffer, then copied to 0x100000.
    98                                      ; 32KB chunks avoid 64KB segment boundary issues in real mode.
    99                                      ; Buffer at 0x20000 provides 256KB of space (more than enough for 131KB kernel).
   100                                      ; MSI B550 CSM: AH=42h works despite AH=41h reporting no LBA.
   101 00000600 BE[6E07]                    mov si, msg_loading_kernel
   102 00000603 E895FF                      call print_string_16
   103                                  
   104                                      ; Initialize DAP for first chunk
   105 00000606 C706[5E08]4000              mov word [dap_k_count], 64
   106 0000060C C706[6008]0000              mov word [dap_k_offset], 0x0000
   107 00000612 C706[6208]0020              mov word [dap_k_seg], 0x2000          ; Segment 0x2000 → phys 0x20000 (128KB)
   108 00000618 66C706[6408]210000-         mov dword [dap_k_lba], 33             ; LBA 33 (after MBR + Stage2)
   108 00000620 00                 
   109 00000621 66C706[6808]000000-         mov dword [dap_k_lba + 4], 0
   109 00000629 00                 
