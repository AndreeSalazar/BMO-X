    46 0000035C E80601              <1>     call pl_print_hex_byte
    47 0000035F E82501              <1>     call pl_print_newline
    48                              <1> 
    49                              <1>     ; ── Test: single INT 13h read to verify disk access works ────────────
    50 00000362 BE[F604]            <1>     mov si, pl_msg_test_read
    51 00000365 E8EC00              <1>     call pl_print_string
    52                              <1> 
    53                              <1>     ; Setup DAP for test read: 1 sector from LBA 1000 to 0x2000:0x0000
    54 00000368 C606[B404]10        <1>     mov byte  [pl_dap],   0x10         ; DAP size
    55 0000036D C606[B504]00        <1>     mov byte  [pl_dap+1], 0            ; reserved
    56 00000372 C706[B604]0100      <1>     mov word  [pl_dap_count], 1        ; 1 sector
    57 00000378 C706[B804]0000      <1>     mov word  [pl_dap_buf_off], 0x0000
    58 0000037E C706[BA04]0020      <1>     mov word  [pl_dap_buf_seg], PL_BUFFER_SEG
    59 00000384 66C706[BC04]E80300- <1>     mov dword [pl_dap_lba], PL_GSP_LBA_START
    59 0000038C 00                  <1>
    60 0000038D 66C706[C004]000000- <1>     mov dword [pl_dap_lba+4], 0
    60 00000395 00                  <1>
    61                              <1> 
    62 00000396 B442                <1>     mov ah, 0x42
    63 00000398 8A16[5A08]          <1>     mov dl, [stage2_boot_drive]
    64 0000039C BE[B404]            <1>     mov si, pl_dap
    65 0000039F CD13                <1>     int 0x13
    66 000003A1 7244                <1>     jc pl_read_error
    67                              <1> 
    68 000003A3 BE[1D05]            <1>     mov si, pl_msg_test_ok
    69 000003A6 E8AB00              <1>     call pl_print_string
    70                              <1> 
    71                              <1>     ; ── Firmware validated — record metadata for kernel ───────────────────
    72                              <1>     ; The full 69.5MB firmware load to 0x1000000 will be done by the kernel
    73                              <1>     ; itself (via PCI DMA or re-reading sectors in protected/long mode).
    74                              <1>     ; The bootloader's job is just to verify the disk is accessible and
    75                              <1>     ; pass the firmware's disk location + size to the kernel.
    76                              <1>     ; ── Record firmware metadata ──────────────────────────────────────────
    77                              <1>     ; The firmware will be copied to 0x1000000 in Protected Mode.
    78                              <1>     ; Record the disk location so PM code can re-read and copy.
    79 000003A9 66C706[A804]E80300- <1>     mov dword [payload_fw_lba], PL_GSP_LBA_START
    79 000003B1 00                  <1>
    80 000003B2 66C706[AC04]C52B02- <1>     mov dword [payload_fw_sectors], PL_GSP_SECTORS + 1
    80 000003BA 00                  <1>
    81 000003BB 66C706[9804]000000- <1>     mov dword [payload_base], 0x1000000
    81 000003C3 01                  <1>
    82 000003C4 66C706[9C04]000000- <1>     mov dword [payload_base+4], 0
    82 000003CC 00                  <1>
    83 000003CD 66C706[A004]F08757- <1>     mov dword [payload_size], PL_GSP_SIZE
    83 000003D5 04                  <1>
    84 000003D6 66C706[A404]000000- <1>     mov dword [payload_size+4], 0
    84 000003DE 00                  <1>
    85                              <1> 
    86 000003DF BE[3205]            <1>     mov si, pl_msg_done
    87 000003E2 E86F00              <1>     call pl_print_string
    88                              <1> 
    89 000003E5 61                  <1>     popa
    90 000003E6 C3                  <1>     ret
    91                              <1> 
