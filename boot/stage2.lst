    24                                  %include "payload_loader.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS Payload Loader — Unreal Mode for GSP Firmware
     3                              <1> ; ============================================================================
     4                              <1> ; Target: RTX 3060 12GB (GA106)
     5                              <1> ; Board: MSI MS-7C52 (B550), AMI Aptio V BIOS
     6                              <1> ;
     7                              <1> ; CONSTRAINTS: NASM -f bin flat binary, no sections, no extern
     8                              <1> ;
     9                              <1> ; BUG FIXES applied:
    10                              <1> ;   1. Restore SS=0 after every Unreal Mode entry so push/pop/call/ret work
    11                              <1> ;   2. Restore DS=0 before INT 13h (BIOS needs real-mode segments)
    12                              <1> ;   3. Error path halts instead of corrupting stack with popa+ret
    13                              <1> ;   4. Save/restore SP around entire function for safety
    14                              <1> ; ============================================================================
    15                              <1> 
    16                              <1> [BITS 16]
    17                              <1> 
    18                              <1> ; ── Constants ───────────────────────────────────────────────────────────────
    19                              <1> GSP_FW_LOAD_ADDR   equ 0x1000000      ; 16MB - firmware target
    20                              <1> GSP_FW_SIZE         equ 72845296       ; 69.5MB = 142,196 sectors
    21                              <1> SECTORS_PER_BLOCK   equ 16             ; B550 limit = 16 sectors (8KB)
    22                              <1> BLOCK_SIZE          equ 8192           ; 16 * 512 = 8KB
    23                              <1> BUFFER_ADDR         equ 0x20000        ; 128KB - safe buffer
    24                              <1> TOTAL_ITERATIONS    equ 8888           ; 142,196 / 16 = 8887.25 → 8888
    25                              <1> 
    26                              <1> ; ── Entry point ─────────────────────────────────────────────────────────────
    27                              <1> ; Called from stage2.asm with: call load_payloads
    28                              <1> ; On return: payload_base and payload_size are set.
    29                              <1> ; Preserves all GPRs via pusha/popa. Stack must be balanced.
    30                              <1> load_payloads:
    31 00000348 60                  <1>     pusha
    32                              <1>     ; Save SP after pusha so we can restore it on error
    33 00000349 8926[5105]          <1>     mov [pl_saved_sp], sp
    34                              <1> 
    35                              <1>     ; Print start message
    36 0000034D BE[8605]            <1>     mov si, pl_msg_start
    37 00000350 E8A801              <1>     call pl_print_string
    38                              <1> 
    39                              <1>     ; Print boot_drive value
    40 00000353 BE[B305]            <1>     mov si, pl_msg_dl
    41 00000356 E8A201              <1>     call pl_print_string
    42 00000359 A0[4005]            <1>     mov al, [payload_boot_drive]
    43 0000035C E8AD01              <1>     call pl_print_hex_byte
    44 0000035F E8CC01              <1>     call pl_print_newline
    45                              <1> 
    46                              <1>     ; Check LBA extensions (informational only — MSI B550 CSM lies about this)
    47 00000362 BE[CE05]            <1>     mov si, pl_msg_lba_check
    48 00000365 E89301              <1>     call pl_print_string
    49 00000368 B441                <1>     mov ah, 0x41
    50 0000036A BBAA55              <1>     mov bx, 0x55AA
    51 0000036D 8A16[4005]          <1>     mov dl, [payload_boot_drive]
    52 00000371 CD13                <1>     int 0x13
    53 00000373 7206                <1>     jc pl_no_lba
    54 00000375 81FB55AA            <1>     cmp bx, 0xAA55
    55 00000379 7408                <1>     je pl_lba_ok
    56                              <1> pl_no_lba:
    57 0000037B BE[1A06]            <1>     mov si, pl_msg_lba_fail
    58 0000037E E87A01              <1>     call pl_print_string
    59 00000381 EB06                <1>     jmp pl_continue_load
    60                              <1> pl_lba_ok:
    61 00000383 BE[F905]            <1>     mov si, pl_msg_lba_ok
    62 00000386 E87201              <1>     call pl_print_string
    63                              <1> pl_continue_load:
    64                              <1> 
    65                              <1>     ; ── Enter Unreal Mode ──────────────────────────────────────────────────
    66                              <1>     ; We need 32-bit addressing for movsd to 0x1000000.
    67                              <1>     ; Process: PM on → load 4GB-limit DS/ES → PM off → segments keep limit.
    68                              <1>     ; CRITICAL: SS must be restored to 0 before any push/pop/call/ret.
    69 00000389 FA                  <1>     cli
    70                              <1> 
    71                              <1>     ; Patch GDT descriptor with physical address (CS*16 + offset)
    72 0000038A 6631C0              <1>     xor eax, eax
    73 0000038D 8CC8                <1>     mov ax, cs
    74 0000038F 66C1E004            <1>     shl eax, 4
    75 00000393 668D1E[7005]        <1>     lea ebx, [pl_unreal_gdt]
    76 00000398 6601D8              <1>     add eax, ebx
    77 0000039B 66A3[8205]          <1>     mov dword [pl_unreal_gdt_desc + 2], eax
    78                              <1> 
    79 0000039F 0F0116[8005]        <1>     lgdt [pl_unreal_gdt_desc]
    80                              <1> 
    81 000003A4 0F20C0              <1>     mov eax, cr0
    82 000003A7 6683C801            <1>     or eax, 1               ; PE = 1 (enter protected mode)
    83 000003AB 0F22C0              <1>     mov cr0, eax
    84                              <1> 
    85 000003AE B80800              <1>     mov ax, 0x08             ; Load 4GB-limit data descriptor
    86 000003B1 8ED8                <1>     mov ds, ax
    87 000003B3 8EC0                <1>     mov es, ax
    88                              <1>     ; NOTE: Do NOT set SS to 0x08. Leave SS alone during PM transition.
    89                              <1>     ;       SS will keep its real-mode base (0x0000) which is correct.
    90                              <1> 
    91 000003B5 0F20C0              <1>     mov eax, cr0
    92 000003B8 6683E0FE            <1>     and eax, 0xFFFFFFFE     ; PE = 0 (back to real mode)
    93 000003BC 0F22C0              <1>     mov cr0, eax
    94                              <1> 
    95                              <1>     ; Restore real-mode segment values for DS/ES
    96                              <1>     ; DS/ES now have 4GB limit (Unreal Mode) but segment base = 0
    97 000003BF 31C0                <1>     xor ax, ax
    98 000003C1 8ED8                <1>     mov ds, ax
    99 000003C3 8EC0                <1>     mov es, ax
   100                              <1>     ; SS was never changed — it's still 0x0000, stack works normally.
   101                              <1> 
   102 000003C5 FB                  <1>     sti
   103                              <1> 
   104                              <1>     ; ── Initialize load loop ───────────────────────────────────────────────
   105 000003C6 66C706[6405]E80300- <1>     mov dword [pl_dap_lba], 1000
   105 000003CE 00                  <1>
   106 000003CF 66C706[6805]000000- <1>     mov dword [pl_dap_lba+4], 0
   106 000003D7 00                  <1>
   107 000003D8 66C706[5405]000000- <1>     mov dword [pl_dest_addr], GSP_FW_LOAD_ADDR
   107 000003E0 01                  <1>
   108 000003E1 C706[5805]B822      <1>     mov word  [pl_remain], TOTAL_ITERATIONS
   109                              <1> 
   110                              <1> pl_load_loop:
   111                              <1>     ; Set sector count: last iteration = 4 sectors, else = 16
   112 000003E7 833E[5805]01        <1>     cmp word [pl_remain], 1
   113 000003EC 7508                <1>     jne pl_full_block
   114 000003EE C706[5E05]0400      <1>     mov word [pl_dap_count], 4
   115 000003F4 EB06                <1>     jmp pl_do_read
   116                              <1> pl_full_block:
   117 000003F6 C706[5E05]1000      <1>     mov word [pl_dap_count], SECTORS_PER_BLOCK
   118                              <1> 
   119                              <1> pl_do_read:
   120                              <1>     ; ── BIOS INT 13h AH=42h needs real-mode segments ──────────────────────
   121                              <1>     ; DS:SI must point to DAP with DS=0 (our DAP is in low memory)
   122 000003FC 31C0                <1>     xor ax, ax
   123 000003FE 8ED8                <1>     mov ds, ax
   124                              <1> 
   125 00000400 B442                <1>     mov ah, 0x42
   126 00000402 8A16[4005]          <1>     mov dl, [payload_boot_drive]
   127 00000406 BE[5C05]            <1>     mov si, pl_dap
   128 00000409 CD13                <1>     int 0x13
   129 0000040B 0F82A000            <1>     jc pl_read_error
   130                              <1> 
   131                              <1>     ; ── Re-enter Unreal Mode for the copy ─────────────────────────────────
   132                              <1>     ; After INT 13h, BIOS may have trashed segment limits/GDT.
   133                              <1>     ; Re-load GDT and re-enter Unreal Mode for the 32-bit copy.
   134 0000040F FA                  <1>     cli
   135                              <1> 
   136 00000410 6631C0              <1>     xor eax, eax
   137 00000413 8CC8                <1>     mov ax, cs
   138 00000415 66C1E004            <1>     shl eax, 4
   139 00000419 668D1E[7005]        <1>     lea ebx, [pl_unreal_gdt]
   140 0000041E 6601D8              <1>     add eax, ebx
   141 00000421 66A3[8205]          <1>     mov dword [pl_unreal_gdt_desc + 2], eax
   142                              <1> 
   143 00000425 0F0116[8005]        <1>     lgdt [pl_unreal_gdt_desc]
   144                              <1> 
   145 0000042A 0F20C0              <1>     mov eax, cr0
   146 0000042D 6683C801            <1>     or eax, 1
   147 00000431 0F22C0              <1>     mov cr0, eax
   148                              <1> 
   149 00000434 B80800              <1>     mov ax, 0x08
   150 00000437 8ED8                <1>     mov ds, ax
   151 00000439 8EC0                <1>     mov es, ax
   152                              <1>     ; Do NOT touch SS — keep it at real-mode 0x0000
   153                              <1> 
   154 0000043B 0F20C0              <1>     mov eax, cr0
   155 0000043E 6683E0FE            <1>     and eax, 0xFFFFFFFE
   156 00000442 0F22C0              <1>     mov cr0, eax
   157                              <1> 
   158                              <1>     ; Restore DS/ES to 0 (keeps 4GB limit from Unreal Mode)
   159 00000445 31C0                <1>     xor ax, ax
   160 00000447 8ED8                <1>     mov ds, ax
   161 00000449 8EC0                <1>     mov es, ax
   162                              <1> 
   163 0000044B FB                  <1>     sti
   164                              <1> 
   165                              <1>     ; ── Copy 8KB from buffer (0x20000) to destination (>1MB) ──────────────
   166                              <1>     ; a32 prefix enables 32-bit addressing in real mode (Unreal Mode)
   167 0000044C 66BE00000200        <1>     mov esi, BUFFER_ADDR
