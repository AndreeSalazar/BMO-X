   333                                  long_mode_entry:
   334 00000A5C 66B81000                    mov ax, GDT64_DATA_SEG
   335 00000A60 8ED8                        mov ds, ax
   336 00000A62 8EC0                        mov es, ax
   337 00000A64 8EE0                        mov fs, ax
   338 00000A66 8EE8                        mov gs, ax
   339 00000A68 8ED0                        mov ss, ax
   340 00000A6A BC00008000                  mov rsp, 0x800000
   341                                  
   342                                      ; VGA: Long Mode active — row after paging msg
   343 00000A6F 480FB60425-                 movzx rax, byte [vga_row]
   343 00000A74 [5B080000]         
   344 00000A78 4883C002                    add rax, 2                      ; PM row + paging row
   345 00000A7C 4869C0A0000000              imul rax, 160
   346 00000A83 480500800B00                add rax, 0xB8000
   347 00000A89 4889C7                      mov rdi, rax
   348 00000A8C 48BE-                       mov rsi, msg_lm_active
   348 00000A8E [BF0B000000000000] 
   349 00000A96 B40E                        mov ah, 0x0E                    ; yellow on black
   350                                  .lm_print:
   351 00000A98 AC                          lodsb
   352 00000A99 84C0                        test al, al
   353 00000A9B 7404                        jz .lm_print_done
   354 00000A9D 66AB                        stosw
   355 00000A9F EBF7                        jmp .lm_print
   356                                  .lm_print_done:
   357                                  
   358                                      ; Init SSE + AVX + AVX2
   359 00000AA1 E877FFFFFF                  call init_sse_avx
   360 00000AA6 E8A7FFFFFF                  call avx2_selftest
   361                                  
   362                                      ; VGA: AVX2 ready — next row
   363 00000AAB 480FB60425-                 movzx rax, byte [vga_row]
   363 00000AB0 [5B080000]         
