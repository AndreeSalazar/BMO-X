   205                                  ; ── 64-bit Long Mode ────────────────────────────────────────────────────
   206                                  
   207                                  [BITS 64]
   208                                  DEFAULT ABS
   209                                  
   210                                  %include "sse_avx.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS SSE + AVX + AVX2 Initialization (64-bit)
     3                              <1> ; ============================================================================
     4                              <1> ; Ryzen 5 5600X: SSE→SSE2→SSE3→SSSE3→SSE4.1→SSE4.2→AVX→AVX2→FMA3
     5                              <1> ;
     6                              <1> ; 1. Enable SSE  (CR0.EM=0, CR0.MP=1, CR4.OSFXSR, CR4.OSXMMEXCPT)
     7                              <1> ; 2. Enable XSAVE (CR4.OSXSAVE)
     8                              <1> ; 3. Enable AVX via XCR0 (bits 0+1+2 = x87 + SSE + AVX)
     9                              <1> ; 4. AVX2/FMA3 usable after AVX enabled
    10                              <1> ; ============================================================================
    11                              <1> 
    12                              <1> [BITS 64]
    13                              <1> 
    14                              <1> init_sse_avx:
    15                              <1>     ; Enable SSE
    16 0000048A 0F20C0              <1>     mov rax, cr0
    17 0000048D 6683E0FB            <1>     and ax, 0xFFFB              ; Clear CR0.EM (bit 2)
    18 00000491 6683C802            <1>     or ax, 0x0002               ; Set CR0.MP (bit 1)
    19 00000495 0F22C0              <1>     mov cr0, rax
    20                              <1> 
    21 00000498 0F20E0              <1>     mov rax, cr4
    22 0000049B 660D0002            <1>     or ax, (1 << 9)             ; CR4.OSFXSR
    23 0000049F 660D0004            <1>     or ax, (1 << 10)            ; CR4.OSXMMEXCPT
    24 000004A3 0F22E0              <1>     mov cr4, rax
    25                              <1> 
    26                              <1>     ; Enable XSAVE
    27 000004A6 0F20E0              <1>     mov rax, cr4
    28 000004A9 480D00000400        <1>     or rax, (1 << 18)           ; CR4.OSXSAVE
    29 000004AF 0F22E0              <1>     mov cr4, rax
    30                              <1> 
    31                              <1>     ; Enable AVX via XCR0
    32 000004B2 4831C9              <1>     xor rcx, rcx
    33 000004B5 0F01D0              <1>     xgetbv
    34 000004B8 83C807              <1>     or eax, 0x07                ; x87 + SSE + AVX
    35 000004BB 0F01D1              <1>     xsetbv
    36                              <1> 
    37 000004BE C3                  <1>     ret
    38                              <1> 
    39                              <1> ; AVX2 self-test
    40                              <1> avx2_selftest:
    41 000004BF C5FD76C0            <1>     db 0xC5, 0xFD, 0x76, 0xC0      ; vpcmpeqd ymm0, ymm0, ymm0
    42 000004C3 C4E27D17C0          <1>     db 0xC4, 0xE2, 0x7D, 0x17, 0xC0 ; vptest ymm0, ymm0
    43 000004C8 C3                  <1>     ret
