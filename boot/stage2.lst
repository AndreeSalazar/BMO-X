     1                                  ; ============================================================================
     2                                  ; FastOS Stage 2 — Real Mode → Protected Mode → Long Mode
     3                                  ; ============================================================================
     4                                  ; Loaded at 0x7E00 by Stage 1.
     5                                  ; Full transition: 16-bit → 32-bit → 64-bit → Rust kernel.
     6                                  ; Target: AMD Ryzen 5 5600X (Zen 3, Vermeer)
     7                                  ; ============================================================================
     8                                  
     9                                  [BITS 16]
    10                                  [ORG 0x7E00]
    11                                  
    12                                  ; ── Entry vector ─────────────────────────────────────────────────────────
    13                                  ; BYTE 0 of stage2.bin — Stage1 jumps here (0x7E00).
    14                                  ; Must be the absolute first instruction. Everything else comes after.
    15                                  ; Fagging-Scale: from this single jmp we bootstrap 16→32→64 bit with ALL
    16                                  ; Zen 3 extensions (SSE4.2, AVX2, FMA3, AES-NI, SHA, BMI1/2).
    17 00000000 E99E01                  jmp stage2_start
    18                                  
    19                                  ; ── Includes (data tables + subroutines, NOT entry points) ──────────────
    20                                  %include "gdt.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS GDT — Global Descriptor Table (32-bit + 64-bit)
     3                              <1> ; ============================================================================
     4                              <1> 
     5                              <1> [BITS 16]
     6                              <1> 
     7                              <1> ; ── 32-bit GDT (protected mode transition) ──────────────────────────────────
     8                              <1> 
     9                              <1> gdt32_start:
    10 00000003 0000000000000000    <1>     dq 0x0000000000000000           ; Null descriptor
    11                              <1> 
    12                              <1> gdt32_code:
    13 0000000B FFFF                <1>     dw 0xFFFF                       ; Limit low
    14 0000000D 0000                <1>     dw 0x0000                       ; Base low
    15 0000000F 00                  <1>     db 0x00                         ; Base mid
    16 00000010 9A                  <1>     db 10011010b                    ; Access: P=1, Ring0, Code, Exec/Read
    17 00000011 CF                  <1>     db 11001111b                    ; Flags: 4KB gran, 32-bit + Limit high
    18 00000012 00                  <1>     db 0x00                         ; Base high
    19                              <1> 
    20                              <1> gdt32_data:
    21 00000013 FFFF                <1>     dw 0xFFFF
    22 00000015 0000                <1>     dw 0x0000
    23 00000017 00                  <1>     db 0x00
    24 00000018 92                  <1>     db 10010010b                    ; Access: P=1, Ring0, Data, R/W
    25 00000019 CF                  <1>     db 11001111b
    26 0000001A 00                  <1>     db 0x00
    27                              <1> 
    28                              <1> gdt32_end:
    29                              <1> 
    30                              <1> gdt32_descriptor:
    31 0000001B 1700                <1>     dw gdt32_end - gdt32_start - 1
    32 0000001D [03000000]          <1>     dd gdt32_start
    33                              <1> 
    34                              <1> GDT32_CODE_SEG equ gdt32_code - gdt32_start   ; 0x08
    35                              <1> GDT32_DATA_SEG equ gdt32_data - gdt32_start   ; 0x10
    36                              <1> 
    37                              <1> ; ── 64-bit GDT (long mode) ──────────────────────────────────────────────────
    38                              <1> 
    39                              <1> gdt64_start:
    40 00000021 0000000000000000    <1>     dq 0x0000000000000000           ; Null descriptor
    41                              <1> 
    42                              <1> gdt64_code:
    43 00000029 0000                <1>     dw 0x0000                       ; Limit (ignored in long mode)
    44 0000002B 0000                <1>     dw 0x0000                       ; Base low
    45 0000002D 00                  <1>     db 0x00                         ; Base mid
    46 0000002E 9A                  <1>     db 10011010b                    ; Access: P=1, Ring0, Code, Exec/Read
    47 0000002F 20                  <1>     db 00100000b                    ; Flags: Long mode (bit 5)
    48 00000030 00                  <1>     db 0x00                         ; Base high
    49                              <1> 
    50                              <1> gdt64_data:
    51 00000031 0000                <1>     dw 0x0000
    52 00000033 0000                <1>     dw 0x0000
    53 00000035 00                  <1>     db 0x00
    54 00000036 92                  <1>     db 10010010b                    ; Access: P=1, Ring0, Data, R/W
    55 00000037 00                  <1>     db 00000000b
    56 00000038 00                  <1>     db 0x00
    57                              <1> 
    58                              <1> gdt64_end:
    59                              <1> 
    60                              <1> gdt64_descriptor:
    61 00000039 1700                <1>     dw gdt64_end - gdt64_start - 1
    62 0000003B [2100000000000000]  <1>     dq gdt64_start
    63                              <1> 
    64                              <1> GDT64_CODE_SEG equ gdt64_code - gdt64_start   ; 0x08
    65                              <1> GDT64_DATA_SEG equ gdt64_data - gdt64_start   ; 0x10
    21                                  %include "a20.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS A20 Line Enable
     3                              <1> ; ============================================================================
     4                              <1> ; Must be enabled to access memory above 1MB.
     5                              <1> ; Tries: BIOS → keyboard controller → fast A20 (port 0x92).
     6                              <1> ; ============================================================================
     7                              <1> 
     8                              <1> [BITS 16]
     9                              <1> 
    10                              <1> enable_a20:
    11                              <1>     ; Method 1: BIOS
    12 00000043 B80124              <1>     mov ax, 0x2401
    13 00000046 CD15                <1>     int 0x15
    14 00000048 7335                <1>     jnc .a20_done
    15                              <1> 
    16                              <1>     ; Method 2: Keyboard controller
    17 0000004A E83300              <1>     call .a20_wait_input
    18 0000004D B0AD                <1>     mov al, 0xAD
    19 0000004F E664                <1>     out 0x64, al
    20 00000051 E82C00              <1>     call .a20_wait_input
    21 00000054 B0D0                <1>     mov al, 0xD0
    22 00000056 E664                <1>     out 0x64, al
    23 00000058 E82C00              <1>     call .a20_wait_output
    24 0000005B E460                <1>     in al, 0x60
    25 0000005D 50                  <1>     push ax
    26 0000005E E81F00              <1>     call .a20_wait_input
    27 00000061 B0D1                <1>     mov al, 0xD1
    28 00000063 E664                <1>     out 0x64, al
    29 00000065 E81800              <1>     call .a20_wait_input
    30 00000068 58                  <1>     pop ax
    31 00000069 0C02                <1>     or al, 0x02
    32 0000006B E660                <1>     out 0x60, al
    33 0000006D E81000              <1>     call .a20_wait_input
    34 00000070 B0AE                <1>     mov al, 0xAE
    35 00000072 E664                <1>     out 0x64, al
    36 00000074 E80900              <1>     call .a20_wait_input
    37                              <1> 
    38                              <1>     ; Method 3: Fast A20
    39 00000077 E492                <1>     in al, 0x92
    40 00000079 0C02                <1>     or al, 0x02
    41 0000007B 24FE                <1>     and al, 0xFE
    42 0000007D E692                <1>     out 0x92, al
    43                              <1> 
    44                              <1> .a20_done:
    45 0000007F C3                  <1>     ret
    46                              <1> 
    47                              <1> .a20_wait_input:
    48 00000080 E464                <1>     in al, 0x64
    49 00000082 A802                <1>     test al, 0x02
    50 00000084 75FA                <1>     jnz .a20_wait_input
    51 00000086 C3                  <1>     ret
    52                              <1> 
    53                              <1> .a20_wait_output:
    54 00000087 E464                <1>     in al, 0x64
    55 00000089 A801                <1>     test al, 0x01
    56 0000008B 74FA                <1>     jz .a20_wait_output
    57 0000008D C3                  <1>     ret
    22                                  %include "memory.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS Memory Detection (INT 15h, E820)
     3                              <1> ; ============================================================================
     4                              <1> ; Stores memory map at MEMORY_MAP_ADDR for the kernel.
     5                              <1> ; Each entry: base(u64) + length(u64) + type(u32) + attrs(u32) = 24 bytes
     6                              <1> ; ============================================================================
     7                              <1> 
     8                              <1> [BITS 16]
     9                              <1> 
    10                              <1> MEMORY_MAP_ADDR  equ 0x8000
    11                              <1> MEMORY_MAP_COUNT equ 0x8000    ; First 4 bytes = count
    12                              <1> 
    13                              <1> detect_memory_e820:
    14 0000008E 6660                <1>     pushad
    15 00000090 66C706008000000000  <1>     mov dword [MEMORY_MAP_ADDR], 0
    16 00000099 6631DB              <1>     xor ebx, ebx
    17 0000009C BF0480              <1>     mov di, MEMORY_MAP_ADDR + 4
    18                              <1> 
    19                              <1> .e820_loop:
    20 0000009F 66B820E80000        <1>     mov eax, 0x0000E820
    21 000000A5 66BA50414D53        <1>     mov edx, 0x534D4150         ; 'SMAP'
    22 000000AB 66B918000000        <1>     mov ecx, 24
    23 000000B1 CD15                <1>     int 0x15
    24 000000B3 7217                <1>     jc .e820_done
    25 000000B5 663D50414D53        <1>     cmp eax, 0x534D4150
    26 000000BB 750F                <1>     jne .e820_done
    27                              <1> 
    28 000000BD 83C718              <1>     add di, 24
    29 000000C0 66FF060080          <1>     inc dword [MEMORY_MAP_ADDR]
    30                              <1> 
    31 000000C5 6685DB              <1>     test ebx, ebx
    32 000000C8 7402                <1>     jz .e820_done
    33 000000CA EBD3                <1>     jmp .e820_loop
    34                              <1> 
    35                              <1> .e820_done:
    36 000000CC 6661                <1>     popad
    37 000000CE C3                  <1>     ret
    23                                  %include "cpucheck.asm"
     1                              <1> ; ============================================================================
     2                              <1> ; FastOS CPU Check — Verify Ryzen 5 5600X capabilities
     3                              <1> ; ============================================================================
     4                              <1> ; Checks: CPUID, Long Mode, SSE, AVX, AVX2, FMA3, AES-NI, SHA, BMI1/2
     5                              <1> ; ============================================================================
     6                              <1> 
     7                              <1> [BITS 16]
     8                              <1> 
     9                              <1> check_cpuid:
    10 000000CF 669C                <1>     pushfd
    11 000000D1 6658                <1>     pop eax
    12 000000D3 6689C1              <1>     mov ecx, eax
    13 000000D6 663500002000        <1>     xor eax, 1 << 21
    14 000000DC 6650                <1>     push eax
    15 000000DE 669D                <1>     popfd
    16 000000E0 669C                <1>     pushfd
    17 000000E2 6658                <1>     pop eax
    18 000000E4 6651                <1>     push ecx
    19 000000E6 669D                <1>     popfd
    20 000000E8 6639C8              <1>     cmp eax, ecx
    21 000000EB 7401                <1>     je .no_cpuid
    22 000000ED C3                  <1>     ret
    23                              <1> .no_cpuid:
    24 000000EE BE[5601]            <1>     mov si, msg_no_cpuid
    25 000000F1 E89C00              <1>     call print_string_16
    26 000000F4 FA                  <1>     cli
    27 000000F5 F4                  <1>     hlt
    28                              <1> 
    29                              <1> check_long_mode:
    30 000000F6 66B800000080        <1>     mov eax, 0x80000000
    31 000000FC 0FA2                <1>     cpuid
    32 000000FE 663D01000080        <1>     cmp eax, 0x80000001
    33 00000104 7212                <1>     jb .no_long_mode
    34 00000106 66B801000080        <1>     mov eax, 0x80000001
    35 0000010C 0FA2                <1>     cpuid
    36 0000010E 66F7C200000020      <1>     test edx, 1 << 29
    37 00000115 7401                <1>     jz .no_long_mode
    38 00000117 C3                  <1>     ret
    39                              <1> .no_long_mode:
    40 00000118 BE[7101]            <1>     mov si, msg_no_lm
    41 0000011B E87200              <1>     call print_string_16
    42 0000011E FA                  <1>     cli
    43 0000011F F4                  <1>     hlt
    44                              <1> 
    45                              <1> ; ── 32-bit: store CPU features for kernel ────────────────────────────────
    46                              <1> 
    47                              <1> [BITS 32]
    48                              <1> 
    49                              <1> CPU_FEATURES_ADDR equ 0x9000
    50                              <1> 
    51                              <1> ; Layout at 0x9000:
    52                              <1> ;   +0  : CPUID(1) EDX  — SSE(25), SSE2(26)
    53                              <1> ;   +4  : CPUID(1) ECX  — SSE3(0), SSE4.1(19), SSE4.2(20), AVX(28), AES(25), FMA(12)
    54                              <1> ;   +8  : CPUID(7) EBX  — AVX2(5), BMI1(3), BMI2(8), SHA(29)
    55                              <1> ;   +12 : CPUID(7) ECX
    56                              <1> ;   +16 : CPUID(0x80000001) EDX — Long Mode(29), NX(20)
    57                              <1> 
    58                              <1> detect_cpu_features_32:
    59 00000120 B801000000          <1>     mov eax, 1
    60 00000125 0FA2                <1>     cpuid
    61 00000127 891500900000        <1>     mov [CPU_FEATURES_ADDR + 0], edx
    62 0000012D 890D04900000        <1>     mov [CPU_FEATURES_ADDR + 4], ecx
    63                              <1> 
    64 00000133 B807000000          <1>     mov eax, 7
    65 00000138 31C9                <1>     xor ecx, ecx
    66 0000013A 0FA2                <1>     cpuid
    67 0000013C 891D08900000        <1>     mov [CPU_FEATURES_ADDR + 8], ebx
    68 00000142 890D0C900000        <1>     mov [CPU_FEATURES_ADDR + 12], ecx
    69                              <1> 
    70 00000148 B801000080          <1>     mov eax, 0x80000001
    71 0000014D 0FA2                <1>     cpuid
    72 0000014F 891510900000        <1>     mov [CPU_FEATURES_ADDR + 16], edx
    73 00000155 C3                  <1>     ret
    74                              <1> 
