   181 00000427 83C820                      or eax, (1 << 5)
   182 0000042A 0F22E0                      mov cr4, eax
   183                                  
   184                                      ; Enable Long Mode (EFER.LME) + NX (EFER.NXE)
   185 0000042D B9800000C0                  mov ecx, 0xC0000080
   186 00000432 0F32                        rdmsr
   187 00000434 0D00010000                  or eax, (1 << 8)               ; LME
   188 00000439 0D00080000                  or eax, (1 << 11)              ; NXE
   189 0000043E 0F30                        wrmsr
   190                                  
   191                                      ; Enable paging + write protect
   192 00000440 0F20C0                      mov eax, cr0
