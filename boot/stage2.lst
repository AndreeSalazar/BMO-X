   185 00000483 66C706[4105]000000- <1>     mov dword [payload_base], GSP_FW_LOAD_ADDR
   185 0000048B 01                  <1>
   186 0000048C 66C706[4505]000000- <1>     mov dword [payload_base+4], 0
   186 00000494 00                  <1>
   187 00000495 66C706[4905]F08757- <1>     mov dword [payload_size], GSP_FW_SIZE
   187 0000049D 04                  <1>
   188 0000049E 66C706[4D05]000000- <1>     mov dword [payload_size+4], 0
   188 000004A6 00                  <1>
   189                              <1> 
   190 000004A7 BE[3F06]            <1>     mov si, pl_msg_done
   191 000004AA E84E00              <1>     call pl_print_string
   192                              <1> 
   193 000004AD 61                  <1>     popa
   194 000004AE C3                  <1>     ret
   195                              <1> 
   196                              <1> ; ── Error handler ─────────────────────────────────────────────────────────
   197                              <1> ; On read error: restore stack to exact state after pusha, then popa+ret.
   198                              <1> ; This ensures the caller (stage2) gets control back cleanly.
   199                              <1> pl_read_error:
