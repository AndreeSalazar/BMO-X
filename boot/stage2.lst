   302 00000AA7 83C820                      or eax, (1 << 5)
   303 00000AAA 0F22E0                      mov cr4, eax
   304                                  
   305                                      ; Enable Long Mode (EFER.LME) + NX (EFER.NXE)
   306 00000AAD B9800000C0                  mov ecx, 0xC0000080
   307 00000AB2 0F32                        rdmsr
   308 00000AB4 0D00010000                  or eax, (1 << 8)               ; LME
   309 00000AB9 0D00080000                  or eax, (1 << 11)              ; NXE
   310 00000ABE 0F30                        wrmsr
   311                                  
   312                                      ; Enable paging + write protect
   313 00000AC0 0F20C0                      mov eax, cr0
   314 00000AC3 0D00000080                  or eax, (1 << 31)              ; PG
   315 00000AC8 0D00000100                  or eax, (1 << 16)              ; WP
   316 00000ACD 0F22C0                      mov cr0, eax
