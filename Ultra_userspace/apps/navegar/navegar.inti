# navegar.inti -- NAVEGAR: la cara de la LAMINA en BMO-X. Version 3.
#
# ===================================================================
#  Que es, en una frase
# ===================================================================
#
# La app con la que se NAVEGA desde BMO-X sin que BMO-X sea un navegador. El
# navegador esta en la ANTENA (un movil, un Arch); lo que llega aqui es la
# pagina YA MAQUETADA --la LAMINA de `platform/shared/bmo-antena`-- y esto la
# PINTA y devuelve clics y teclas. La propuesta maestra, con los escalones y
# lo que le falta, es `docs/plan/PLAN_NAVEGAR.md`.
#
# Eddi: *"una app simple pero que tenga mensaje que se necesita conectar con
# ANTENA (da igual cual) pero ANTENA SIEMPRE"*.
#
# ===================================================================
#  ** LA VERSION 3: LA LAMINA OFRECIDA (2026-09-18, N3)
# ===================================================================
#
# La version 2 leia la lamina del disco. Esta la recibe PRESTADA: el
# ANTENISTA (dentro del DIRECTOR, `commands/antenista.rs`) guarda la lamina
# que trajo `red pagina` en un bloque suyo y, al lanzarnos, nos la OFRECE
# (`MEM_OP_OFRECER`). Aqui se TOMA (`op_tomar`) en los primeros fotogramas y
# se pinta desde la memoria del DIRECTOR, mapeada en la nuestra: ni copia,
# ni fichero, ni un syscall por byte. Es el mismo prestamo con el que una app
# entrega su superficie al DIRECTOR, al reves.
#
#     hay oferta (INTENTOS_TOMAR fotogramas)   se pinta lo prestado
#     no la hay                                 el disco, como la version 2
#
# Cuando el DIRECTOR pinte titulos, el titulo dira de donde salio la lamina.
# Hoy lo dice el estado de la caja de `run`: "lanzado, lamina ofrecida".
#
# ===================================================================
#  ** LA VERSION 2: UNA LAMINA DE FICHERO (2026-09-18, N2)
# ===================================================================
#
# La version 1 (N1, vista en el Ryzen el 18-09) abria la ventana con el
# mensaje. Esta ademas PINTA UNA LAMINA: si en el disco hay
# `datos/ejemplo.lam` (la de example.com, la misma que la antena manda),
# la recorre con `usa lamina` --las reglas de `lamina.rs`, en INTI-- y la
# ensena en una ventana de 640x400 con desplazamiento (flechas, AvPag/RePag).
#
#     hay lamina en el disco     se pinta; una lamina MAL HECHA se niega con
#                                su nombre y su linea, encima, en naranja
#     no la hay                  el mensaje de la version 1: hace falta una
#                                ANTENA, y no se finge
#     nadie compone              el mensaje por consola, y codigo 1
#
# ** Lo que sigue sin haber: una antena de verdad. La lamina del disco es
# una PRUEBA de que BMO-X sabe pintar lo que la antena manda, no una pagina
# navegada. Lo dice el titulo de la ventana... cuando el DIRECTOR lo pinte;
# hoy lo dice esta cabecera. El ANTENISTA (N3) es quien traera laminas vivas.
#
# [!] Del `.ibx` NO se lee todavia: `paquete.recurso` no tiene cuerpo en INTI
# (E0075). Por eso la lamina viene de DATOS, como la foto de `bico.ibx`. El
# dia que `paquete` tenga cuerpo, se cambia `lee_lamina` y nada mas.
#
# ===================================================================
#  La regla que no cambia con las versiones
# ===================================================================
#
#     sin antena no hay pagina, y esta app NO LO TAPA:
#     ni cache, ni "ultima vista", ni pantalla en blanco que parezca cargar.
#     Dice que falta la antena, con ese nombre, y espera.
#
# ** R-APP8: lo que no se ve, no se pinta. La ventana se pinta UNA vez y se
# repinta al desplazar y cuando vuelve a verse; entre vuelta y vuelta duerme
# 16 ms (`espera_a`), asi que en reposo no gasta (R21/L6h).

perfil llano
usa bmo
usa superficie
usa lamina

ANCHO = 640
ALTO = 400
ANCHO_MENSAJE = 480
ALTO_MENSAJE = 112
RANURAS = 64
FONDO = 1315860
TITULO = 16777215
TEXTO = 13421772
AVISO = 16755200
ESC = 27
LETRA_Q = 113
SC_ARRIBA = 72
SC_ABAJO = 80
SC_REPAG = 73
SC_AVPAG = 81
PASO = 32
UN_FOTOGRAMA_NS = 16000000
BLOQUE_BYTES = 262144
SIN_LAMINA = 18446744073709551615
# Fotogramas que se espera la oferta del ANTENISTA antes de ir al disco. La
# oferta sale en la misma vuelta del escritorio que nos lanza, asi que uno
# suele bastar; ocho (128 ms) es por si el DIRECTOR va tarde. Sin antenista,
# ese es el precio de arrancar: 128 ms una vez.
INTENTOS_TOMAR = 8

# ===================================================================
#  1. El mensaje, de ocho en ocho (es lo que `llano` tiene: palabras)
# ===================================================================

# En la ventana: una linea es una fila de palabras, cada una devuelve la x
# siguiente. Por consola: las mismas palabras, una detras de otra.

funcion linea_1(s es natural64, fy es natural64, color es natural64)
    cambiante x es natural64 = 8
    x = pon(s, x, fy, ocho_bytes("NAVEGAR "), color)
    x = pon(s, x, fy, ocho_bytes("-- la pa"), color)
    x = pon(s, x, fy, ocho_bytes("gina se "), color)
    x = pon(s, x, fy, ocho_bytes("ve aqui,"), color)
    x = pon(s, x, fy, ocho_bytes(" el nave"), color)
    x = pon(s, x, fy, ocho_bytes("gador vi"), color)
    x = pon(s, x, fy, ocho_bytes("ve en la"), color)
    x = pon(s, x, fy, ocho_bytes(" ANTENA."), color)
    fin_de_linea(s)

funcion linea_2(s es natural64, fy es natural64, color es natural64)
    cambiante x es natural64 = 8
    x = pon(s, x, fy, ocho_bytes("Hace fal"), color)
    x = pon(s, x, fy, ocho_bytes("ta una A"), color)
    x = pon(s, x, fy, ocho_bytes("NTENA. D"), color)
    x = pon(s, x, fy, ocho_bytes("a igual "), color)
    x = pon(s, x, fy, ocho_bytes("cual, pe"), color)
    x = pon(s, x, fy, ocho_bytes("ro ANTEN"), color)
    x = pon(s, x, fy, ocho_bytes("A siempr"), color)
    x = pon(s, x, fy, ocho_bytes("e.      "), color)
    fin_de_linea(s)

funcion linea_3(s es natural64, fy es natural64, color es natural64)
    cambiante x es natural64 = 8
    x = pon(s, x, fy, ocho_bytes("Ninguna "), color)
    x = pon(s, x, fy, ocho_bytes("conectad"), color)
    x = pon(s, x, fy, ocho_bytes("a: sin a"), color)
    x = pon(s, x, fy, ocho_bytes("ntena, B"), color)
    x = pon(s, x, fy, ocho_bytes("MO-X no "), color)
    x = pon(s, x, fy, ocho_bytes("navega y"), color)
    x = pon(s, x, fy, ocho_bytes(" no fing"), color)
    x = pon(s, x, fy, ocho_bytes("e que si"), color)
    x = pon(s, x, fy, ocho_bytes(".       "), color)
    fin_de_linea(s)

funcion linea_4(s es natural64, fy es natural64, color es natural64)
    cambiante x es natural64 = 8
    x = pon(s, x, fy, ocho_bytes("Enciende"), color)
    x = pon(s, x, fy, ocho_bytes(" la ante"), color)
    x = pon(s, x, fy, ocho_bytes("na en la"), color)
    x = pon(s, x, fy, ocho_bytes(" misma r"), color)
    x = pon(s, x, fy, ocho_bytes("ed (tool"), color)
    x = pon(s, x, fy, ocho_bytes("chain/to"), color)
    x = pon(s, x, fy, ocho_bytes("ols/ante"), color)
    x = pon(s, x, fy, ocho_bytes("na).    "), color)
    fin_de_linea(s)

funcion linea_5(s es natural64, fy es natural64, color es natural64)
    cambiante x es natural64 = 8
    x = pon(s, x, fy, ocho_bytes("Esc cier"), color)
    x = pon(s, x, fy, ocho_bytes("ra.     "), color)
    fin_de_linea(s)

# Una palabra: en la ventana si la hay, por consola si no.
funcion pon(s es natural64, x es natural64, fy es natural64, palabra es natural64, color es natural64) devuelve natural64
    si s = 0
        invoca(mi_tarea, op_consola_escribir, palabra, 0, 0)
        devuelve x
    devuelve texto_en(s, x, fy, palabra, color)

funcion fin_de_linea(s es natural64)
    si s = 0
        invoca(mi_tarea, op_consola_escribir, 10, 0, 0)

# Un numero en decimal, cifra a cifra (hasta 65535). Devuelve la x siguiente.
funcion pon_numero(s es natural64, x es natural64, fy es natural64, n es natural64, color es natural64) devuelve natural64
    cambiante px es natural64 = x
    cambiante potencia es natural64 = 10000
    cambiante empezo es natural64 = 0
    repite mientras potencia >= 1
        cifra es natural64 = (n entre potencia) resto 10
        si cifra no es 0 o empezo = 1 o potencia = 1
            px = texto_en(s, px, fy, 48 + cifra, color)
            empezo = 1
        potencia = potencia entre 10
    devuelve px

# ===================================================================
#  2. Los dibujos
# ===================================================================

# El mensaje de la version 1: no hay lamina, hace falta la antena.
funcion dibuja_mensaje(s es natural64)
    limpia(s, FONDO)
    linea_1(s, 8, TITULO)
    linea_2(s, 32, AVISO)
    linea_3(s, 48, TEXTO)
    linea_4(s, 64, TEXTO)
    linea_5(s, 88, TEXTO)
    pinta(s)

# Una lamina que se NIEGA: su nombre y su linea, en naranja, encima de lo
# que llego a pintarse. `rechazo` es `codigo * 65536 + linea`.
funcion dibuja_rechazo(s es natural64, rechazo es natural64)
    rectangulo(s, 0, 0, ANCHO, 40, FONDO)
    cambiante x es natural64 = 8
    x = pon(s, x, 8, ocho_bytes("LAMINA r"), AVISO)
    x = pon(s, x, 8, ocho_bytes("echazada"), AVISO)
    x = pon(s, x, 8, ocho_bytes(": "), AVISO)
    x = pon(s, x, 8, lamina_nombre(rechazo desplaza derecha 16), AVISO)
    x = pon(s, x, 8, ocho_bytes(", linea "), AVISO)
    x = pon_numero(s, x, 8, rechazo bits_y 65535, AVISO)
    x = 8
    x = pon(s, x, 24, ocho_bytes("no se fi"), TEXTO)
    x = pon(s, x, 24, ocho_bytes("nge una "), TEXTO)
    x = pon(s, x, 24, ocho_bytes("pagina. "), TEXTO)
    x = pon(s, x, 24, ocho_bytes("Esc cier"), TEXTO)
    x = pon(s, x, 24, ocho_bytes("ra.     "), TEXTO)

# La lamina, desplazada. Devuelve el rechazo (0 = pinto entera).
funcion dibuja_lamina(s es natural64, base es natural64, largo es natural64, desliz es natural64) devuelve natural64
    limpia(s, FONDO)
    rechazo es natural64 = lamina_pinta(s, base, largo, desliz)
    si rechazo no es 0
        dibuja_rechazo(s, rechazo)
    pinta(s)
    devuelve rechazo

# ===================================================================
#  3. El fichero
# ===================================================================

# `datos/pagina.lam` (lo ultimo que trajo la antena, `red pagina`) o, si no
# esta, `datos/ejemplo.lam` (example.com, la copia el build): entero al
# bloque. Devuelve cuantos bytes, o SIN_LAMINA si no hay ninguna o no cabe.
#
# [!] Nombres 8.3: el FAT32 de BMO-X busca por nombre corto y se salta los
# largos. `ejemplo.lamina` no se encontraria nunca; `ejemplo.lam` si.
funcion lee_lamina(bloque es natural64) devuelve natural64
    invoca(mi_tarea, op_ruta, ocho_bytes("datos/pa"), 0, 0)
    invoca(mi_tarea, op_ruta, ocho_bytes("gina.lam"), 0, 0)
    cambiante f es natural64 = invoca_valor(mi_tarea, op_archivo_abrir, 0, 0, 0)
    si f = 0
        invoca(mi_tarea, op_ruta, ocho_bytes("datos/ej"), 0, 0)
        invoca(mi_tarea, op_ruta, ocho_bytes("emplo.la"), 0, 0)
        invoca(mi_tarea, op_ruta, ocho_bytes("m"), 0, 0)
        f = invoca_valor(mi_tarea, op_archivo_abrir, 0, 0, 0)
    si f = 0
        devuelve SIN_LAMINA
    medida es natural64 = invoca_valor(f, op_arch_tamano, 0, 0, 0)
    si medida = 0 o medida > BLOQUE_BYTES
        invoca(f, op_arch_cerrar, 0, 0, 0)
        devuelve SIN_LAMINA
    cambiante hechos es natural64 = 0
    cambiante sigue es natural64 = 1
    repite mientras sigue = 1 y hechos < medida
        cambiante leidos es natural64 = invoca_valor(f, op_arch_leer_en, bloque, hechos, medida - hechos)
        si leidos = 0
            sigue = 0
        hechos = hechos + leidos
    invoca(f, op_arch_cerrar, 0, 0, 0)
    si hechos no es medida
        devuelve SIN_LAMINA
    devuelve hechos

# ===================================================================
#  3b. El prestamo (N3)
# ===================================================================

# El handle de lo que el ANTENISTA nos ofrecio, o 0 si en INTENTOS_TOMAR
# fotogramas no llego nada. `prestado_base`/`prestado_bytes` sobre el handle
# dicen donde y cuanto.
funcion toma_prestamo() devuelve natural64
    cambiante i es natural64 = 0
    repite mientras i < INTENTOS_TOMAR
        cambiante h es natural64 = invoca_valor(mi_tarea, op_tomar, 0, 0, 0)
        si h no es 0
            devuelve h
        i = i + 1
        espera_a(0, 0, UN_FOTOGRAMA_NS)
    devuelve 0

# ===================================================================
#  4. El programa
# ===================================================================

# Hasta donde se puede desplazar: el alto de la lamina menos la ventana.
funcion tope_de(base es natural64, largo es natural64) devuelve natural64
    cab es natural64 = lamina_cabecera(base, largo)
    si cab = SIN_LAMINA
        devuelve 0
    alto es natural64 = lamina_alto(cab)
    si alto <= ALTO
        devuelve 0
    devuelve alto - ALTO

# El desplazamiento nuevo para una tecla cruda (scancode Set 1), o el mismo.
funcion desliza(desliz es natural64, tecla es natural64, tope es natural64) devuelve natural64
    si tecla = SC_ABAJO
        si desliz + PASO > tope
            devuelve tope
        devuelve desliz + PASO
    si tecla = SC_AVPAG
        si desliz + ALTO > tope
            devuelve tope
        devuelve desliz + ALTO
    si tecla = SC_ARRIBA
        si desliz < PASO
            devuelve 0
        devuelve desliz - PASO
    si tecla = SC_REPAG
        si desliz < ALTO
            devuelve 0
        devuelve desliz - ALTO
    devuelve desliz

funcion principal devuelve entero32
    # Primero la lamina, si la hay: decide el tamano de la ventana.
    # N3: lo que el ANTENISTA ofrecio va delante; el disco es lo que queda.
    cambiante base es natural64 = 0
    cambiante largo es natural64 = SIN_LAMINA
    prestamo es natural64 = toma_prestamo()
    si prestamo no es 0
        base = invoca_valor(prestamo, prestado_base, 0, 0, 0)
        largo = invoca_valor(prestamo, prestado_bytes, 0, 0, 0)
        si base = 0 o largo = 0 o largo > BLOQUE_BYTES
            largo = SIN_LAMINA
    si largo = SIN_LAMINA
        bloque es natural64 = invoca_valor(mi_tarea, op_pedir_memoria, BLOQUE_BYTES, 0, 0)
        si bloque no es 0
            base = invoca_valor(bloque, op_base_del_bloque, 0, 0, 0)
            largo = lee_lamina(bloque)
    cambiante ancho_v es natural64 = ANCHO_MENSAJE
    cambiante alto_v es natural64 = ALTO_MENSAJE
    si largo no es SIN_LAMINA
        ancho_v = ANCHO
        alto_v = ALTO
    cambiante s es natural64 = superficie_crear_con_buzon(ancho_v, alto_v, RANURAS)
    si s = 0
        # Nadie compone: el mensaje por consola, y se dice con el codigo.
        linea_1(0, 0, 0)
        linea_2(0, 0, 0)
        linea_3(0, 0, 0)
        linea_4(0, 0, 0)
        devuelve 1
    cambiante desliz es natural64 = 0
    cambiante tope es natural64 = 0
    si largo = SIN_LAMINA
        dibuja_mensaje(s)
    si largo no es SIN_LAMINA
        tope = tope_de(base, largo)
        dibuja_lamina(s, base, largo, desliz)
    cambiante antes es natural64 = 1
    repite mientras 1 = 1
        cambiante repintar es natural64 = 0
        # Hasta 64 eventos por vuelta; lo que no se lea espera a la siguiente.
        cambiante i es natural64 = 0
        repite mientras i < 64
            i = i + 1
            cambiante e es natural64 = superficie_evento(s)
            si evento_hay(e) = 0
                i = 64
            si evento_hay(e) = 1
                # El orden de las tres preguntas no es libre: raton, letra,
                # ventana, y solo entonces el byte bajo.
                si evento_es_letra(e) = 1
                    si evento_letra_de(e) = ESC o evento_letra_de(e) = LETRA_Q
                        devuelve 0
                si evento_es_letra(e) = 0 y evento_es_raton(e) = 0 y evento_es_configurar(e) = 0
                    # Una tecla cruda, pulsada: las flechas desplazan.
                    si evento_pulsada(e) = 1 y largo no es SIN_LAMINA
                        cambiante nuevo es natural64 = desliza(desliz, e bits_y 255, tope)
                        si nuevo no es desliz
                            desliz = nuevo
                            repintar = 1
        # R-APP8: al volver a verse se repinta; mientras no se ve, nada.
        cambiante se_ve es natural64 = superficie_se_ve(s)
        si se_ve = 1 y antes = 0
            repintar = 1
        antes = se_ve
        si repintar = 1 y se_ve = 1
            si largo = SIN_LAMINA
                dibuja_mensaje(s)
            si largo no es SIN_LAMINA
                dibuja_lamina(s, base, largo, desliz)
        espera_a(0, 0, UN_FOTOGRAMA_NS)
    devuelve 0
